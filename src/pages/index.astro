---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Tecnologias from '../components/Tecnologias.astro';
import Proyectos from '../components/Proyectos.astro';
import Experiencia from '../components/Experiencia.astro';
import Contacto from '../components/Contacto.astro';
import { es } from '../i18n/es';
---

<Layout
  title="Juan Hoyos | Desarrollador Full Stack"
  description="Portafolio de Juan Esteban Hoyos, desarrollador Full Stack en Colombia. Productos digitales completos, de la pantalla a lo que funciona por dentro."
>
  <Header />
  <main id="main-content" tabindex="-1">
    <Hero
      subtitle={es.hero_subtitle}
      description={es.hero_description}
      badge={es.hero_badge}
      btn_linkedin={es.hero_btn_linkedin}
      btn_cv={es.hero_btn_cv}
      cv_path={es.cv_path}
      scroll_label={es.hero_scroll}
    />
    <Manifesto />
    <Tecnologias />
    <Proyectos
      title={es.proyectos_title}
      descriptions={es.projects}
      cta={es.proyectos_cta}
      close={es.proyectos_cerrar}
    />
    <Experiencia
      title={es.experiencia_title}
      descriptions={es.experiences}
      labels={es.experiences_type}
    />
    <Contacto
      title={es.contacto_title}
      subtitle={es.contacto_subtitle}
      btn_email={es.contacto_btn_email}
      description={es.contacto_description}
      formulario_nombre={es.contacto_fomulario_nombre}
      formulario_email={es.contacto_fomulario_email}
      formulario_mensaje={es.contacto_fomulario_mensaje}
    />
  </main>
</Layout>

<script>
  import { initPortfolioPage } from '../util/page';

  initPortfolioPage();
</script>
