---
import '../styles/global.css';
import CursorGota from '../components/CursorGota.astro';
import Loader from '../components/Loader.astro';
import ScrollWorld from '../components/ScrollWorld.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Juan Hoyos | Full Stack Developer',
  description = 'Portafolio de Juan Hoyos, desarrollador Full Stack de Colombia. Especializado en React, Node.js, Astro y más.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html
  class="is-loading"
  lang={Astro.url.pathname.startsWith('/en') ? 'en' : 'es'}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Juan Hoyos" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.png" />
    <meta
      property="og:locale"
      content={Astro.url.pathname.startsWith('/en') ? 'en_US' : 'es_CO'}
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;700&family=Space+Grotesk:wght@400;500;600;700;900&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />

    <noscript
      ><style>
        #loader {
          display: none !important;
        }
        html.is-loading {
          scrollbar-width: auto;
        }
        html.is-loading ::-webkit-scrollbar {
          display: block;
        }
      </style></noscript
    >

    <script is:inline>
      // Tema y estado JS antes del primer paint.
      document.documentElement.classList.add('js');
      (function () {
        try {
          if (localStorage.getItem('theme') === 'light') {
            document.documentElement.classList.add('light');
          }
        } catch (error) {
          /* ignora */
        }
      })();
      // Arrancar siempre desde el tope (el loader revela la página desde arriba)
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      // Red de seguridad: si el bundle falla, no dejar el Hero oculto.
      window.setTimeout(function () {
        var hero = document.getElementById('inicio');
        if (hero && hero.hasAttribute('data-hero-pending')) {
          hero.removeAttribute('data-hero-pending');
        }
      }, 5000);
      // La barra de scroll queda oculta mientras el loader esté activo.
      window.addEventListener('loader:done', () => {
        document.documentElement.classList.remove('is-loading');
      });
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      {Astro.url.pathname.startsWith('/en') ? 'Skip to content' : 'Saltar al contenido'}
    </a>
    <ScrollWorld />
    <div class="scroll-progress" aria-hidden="true">
      <span id="scroll-progress-bar" class="scroll-progress__bar"></span>
    </div>
    <div class="grain" aria-hidden="true"></div>
    <Loader />
    <slot />
    <CursorGota />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 9999;
    transform: translateY(-160%);
    padding: 0.75rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--color-blanco);
    background: var(--color-neutro);
    color: var(--color-blanco);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: transform 0.2s ease;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
    outline: none;
  }
</style>
