---
import '../styles/global.css';
import CursorGota from '../components/CursorGota.astro';
import Loader from '../components/Loader.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Juan Hoyos | Full Stack Developer',
  description = 'Portafolio de Juan Hoyos, desarrollador Full Stack de Colombia. Especializado en React, Node.js, Astro y más.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html
  class="is-loading"
  lang={Astro.url.pathname.startsWith('/en') ? 'en' : 'es'}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Juan Hoyos" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.png" />
    <meta
      property="og:locale"
      content={Astro.url.pathname.startsWith('/en') ? 'en_US' : 'es_CO'}
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;700&family=Space+Grotesk:wght@400;500;600;700;900&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />

    <noscript
      ><style>
        #loader {
          display: none !important;
        }
        html.is-loading {
          scrollbar-width: auto;
        }
        html.is-loading ::-webkit-scrollbar {
          display: block;
        }
      </style></noscript
    >

    <script is:inline>
      // Arrancar siempre desde el tope (el loader revela la página desde arriba)
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      // La barra de scroll queda oculta mientras el loader esté activo.
      window.addEventListener('loader:done', () => {
        document.documentElement.classList.remove('is-loading');
      });
    </script>
  </head>

  <body>
    <Loader />
    <slot />
    <CursorGota />
  </body>
</html>
