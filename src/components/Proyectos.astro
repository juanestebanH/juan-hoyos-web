---
import { Icon } from 'astro-icon/components';
import { projects } from '../data/projects';
import { es } from '../i18n/es';
import { en } from '../i18n/en';

interface Props {
  title: string;
  descriptions: Record<string, string>;
  cta: string;
  close: string;
}

const { title, descriptions, cta, close } = Astro.props;
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const t = lang === 'en' ? en : es;

const projectsWithDesc = projects.map((project, index) => ({
  ...project,
  index,
  description: descriptions[project.id] ?? '',
}));
---

<section id="proyectos" class="works">
  <div class="works-glow" aria-hidden="true"></div>

  <div class="works-head">
    <div>
      <span class="act-kicker">{t.works.kicker}</span>
      <h2 class="works-title" id="works-title">{title}</h2>
    </div>

    <div class="works-readout">
      <span class="works-readout__label">{t.works.now_showing}</span>
      <span class="works-readout__name" id="works-current-title">
        {projectsWithDesc[0].title}
      </span>
      <span class="works-readout__count">
        <span id="works-current">01</span>
        <span class="works-readout__slash">/</span>
        {String(projectsWithDesc.length).padStart(2, '0')}
      </span>
    </div>
  </div>

  <div class="works-viewport" id="works-viewport">
    <div class="works-track" id="works-track">
      {
        projectsWithDesc.map((project) => (
          <article class="work" data-index={project.index}>
            <button
              type="button"
              class="work__media"
              data-case
              aria-label={`${t.works.open_case}: ${project.title}`}
            >
              <img
                src={project.image.src}
                alt={project.title}
                class="work__img"
                draggable="false"
              />
              <span class="work__ghost" aria-hidden="true">
                {String(project.index + 1).padStart(2, '0')}
              </span>
              <span class="work__scan" aria-hidden="true" />
              <span class="work__veil" aria-hidden="true" />
              <span class="work__open">
                <Icon name="mdi:arrow-expand" class="work__open-icon" />
                {cta}
              </span>
            </button>

            <div class="work__row">
              <div class="work__info">
                <div class="work__meta">
                  <span>{String(project.index + 1).padStart(2, '0')}</span>
                  <span>{project.year}</span>
                  <span class="work__status">{project.status}</span>
                </div>
                <h3 class="work__title">{project.title}</h3>
                <p class="work__desc">{project.description}</p>
              </div>

              <div class="work__aside">
                <div class="work__tags">
                  {project.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>

                <div class="work__links">
                  <a
                    data-demo
                    href={project.demo}
                    target="_blank"
                    rel="noopener"
                    aria-label={`Demo ${project.title}`}
                  >
                    <Icon name="mdi:external-link" />
                    <span>{t.works.demo}</span>
                  </a>
                  <a
                    data-code
                    href={project.code}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${t.works.code} ${project.title}`}
                  >
                    <Icon name="mdi:github" />
                    <span>{t.works.code}</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="works-foot">
    <div class="works-progress" aria-hidden="true">
      <span class="works-progress__fill" id="works-fill"></span>
    </div>

    <div class="works-steps">
      {
        projectsWithDesc.map((project) => (
          <button
            class:list={['works-step', { 'is-active': project.index === 0 }]}
            type="button"
            data-step={project.index}
            aria-label={project.title}
          >
            {String(project.index + 1).padStart(2, '0')}
          </button>
        ))
      }
    </div>

    <span class="works-hint">{t.works.hint}</span>
  </div>
</section>

<canvas id="project-gl" class="project-gl" aria-hidden="true"></canvas>

<div id="project-case" class="case" aria-hidden="true">
  <div class="case__backdrop" data-case-close></div>

  <div
    class="case__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="case-title"
    tabindex="-1"
  >
    <button
      type="button"
      data-case-close
      class="case__close"
      aria-label={close}
    >
      <Icon name="mdi:close" class="case__close-icon" />
    </button>

    <div class="case__media">
      <img id="case-image" src="" alt="" />
      <span class="case__index" id="case-index">01</span>
      <span class="case__scan" aria-hidden="true"></span>
    </div>

    <div class="case__body">
      <span class="case__kicker" id="case-kicker">{t.works.kicker}</span>
      <h3 class="case__title" id="case-title"></h3>
      <p class="case__desc" id="case-desc"></p>
      <div class="case__tags" id="case-tags"></div>

      <div class="case__meta">
        <div>
          <span>{t.works.year}</span>
          <strong id="case-year"></strong>
        </div>
        <div>
          <span>{t.works.status}</span>
          <strong id="case-status"></strong>
        </div>
        <div>
          <span>{t.works.stack}</span>
          <strong id="case-stack"></strong>
        </div>
      </div>

      <div class="case__links">
        <a id="case-demo" target="_blank" rel="noopener">
          <Icon name="mdi:external-link" class="case__link-icon" />
          {t.works.demo}
        </a>
        <a id="case-code" target="_blank" rel="noopener">
          <Icon name="mdi:github" class="case__link-icon" />
          {t.works.code}
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { splitMaskWords } from '../util/text';
  import { createProjectDistortion } from '../util/projectDistortion';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  let ctx: gsap.Context | undefined;
  let inited = false;
  let distortion: ReturnType<typeof createProjectDistortion> | null = null;
  let removeCaseListeners: (() => void) | undefined;

  function initProjects() {
    const section = document.getElementById('proyectos');
    if (!section || inited) return;
    inited = true;

    const reduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    const projects = Array.from(section.querySelectorAll<HTMLElement>('.work'));
    const viewport = section.querySelector<HTMLElement>('#works-viewport');
    const track = section.querySelector<HTMLElement>('#works-track');
    const fill = document.getElementById('works-fill');
    const current = document.getElementById('works-current');
    const currentTitle = document.getElementById('works-current-title');
    const steps = Array.from(
      section.querySelectorAll<HTMLElement>('[data-step]'),
    );
    const titleWords = splitMaskWords(document.getElementById('works-title'));
    const glCanvas = document.getElementById(
      'project-gl',
    ) as HTMLCanvasElement | null;
    const caseEl = document.getElementById('project-case');
    if (caseEl) document.body.appendChild(caseEl);
    const caseDialog = caseEl?.querySelector<HTMLElement>('.case__dialog');
    const caseImage = document.getElementById(
      'case-image',
    ) as HTMLImageElement | null;
    const caseTitle = document.getElementById('case-title');
    const caseDesc = document.getElementById('case-desc');
    const caseTags = document.getElementById('case-tags');
    const caseYear = document.getElementById('case-year');
    const caseStatus = document.getElementById('case-status');
    const caseStack = document.getElementById('case-stack');
    const caseIndex = document.getElementById('case-index');
    const caseDemo = document.getElementById(
      'case-demo',
    ) as HTMLAnchorElement | null;
    const caseCode = document.getElementById(
      'case-code',
    ) as HTMLAnchorElement | null;
    const caseClose = caseEl?.querySelector<HTMLButtonElement>('.case__close');
    const main = document.querySelector('main');
    const hud = document.getElementById('hud');
    const skipLink = document.querySelector<HTMLElement>('.skip-link');
    const lenis = () => (window as unknown as { __lenis?: any }).__lenis;
    let lastFocus: HTMLElement | null = null;
    let caseOpen = false;
    let activeIndex = -1;
    let activeTrigger: ScrollTrigger | undefined;

    if (!viewport || !track) return;

    const setActive = (index: number, animate = true) => {
      if (index === activeIndex) return;
      activeIndex = index;
      const card = projects[index];
      if (!card) return;
      projects.forEach((project, i) => {
        project.classList.toggle('is-active', i === index);
      });
      steps.forEach((step, i) =>
        step.classList.toggle('is-active', i === index),
      );
      if (current) current.textContent = String(index + 1).padStart(2, '0');
      if (currentTitle)
        currentTitle.textContent =
          card.querySelector('.work__title')?.textContent ?? '';

      if (!reduced && animate) {
        const media = card.querySelector<HTMLElement>('.work__media');
        const info = card.querySelector<HTMLElement>('.work__info');
        const aside = card.querySelector<HTMLElement>('.work__aside');
        const moving = [info, aside].filter(Boolean) as HTMLElement[];
        gsap.killTweensOf(
          [media, ...moving].filter(Boolean),
          'opacity,scale,y',
        );
        if (media) {
          gsap.fromTo(
            media,
            { opacity: 0.25, scale: 0.96 },
            { opacity: 1, scale: 1, duration: 0.9, ease: 'expo.out' },
          );
        }
        if (moving.length) {
          gsap.fromTo(
            moving,
            { y: 32, scale: 0.97, opacity: 0 },
            {
              y: 0,
              scale: 1,
              opacity: 1,
              duration: 0.7,
              stagger: 0.08,
              ease: 'power3.out',
            },
          );
        }
      }
    };

    ctx = gsap.context(() => {
      if (!reduced) {
        gsap.from(titleWords, {
          yPercent: 115,
          duration: 0.95,
          stagger: 0.08,
          ease: 'expo.out',
          scrollTrigger: {
            trigger: '.works-head',
            start: 'top 92%',
            end: 'top 54%',
            scrub: 1,
          },
        });

        gsap.from('.works-readout', {
          opacity: 0,
          y: 44,
          x: 22,
          scale: 0.96,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '.works-head',
            start: 'top 92%',
            end: 'top 58%',
            scrub: 1,
          },
        });

        // ── Entrada de las cards: wipe de la imagen, slide lateral, número fantasma
        //    y textos en cascada. Se reproduce al llegar y se revierte al subir. ──
        const medias = projects
          .map((project) => project.querySelector<HTMLElement>('.work__media'))
          .filter(Boolean) as HTMLElement[];
        const ghosts = projects
          .map((project) => project.querySelector<HTMLElement>('.work__ghost'))
          .filter(Boolean) as HTMLElement[];
        const dx = window.innerWidth >= 1024 ? 150 : 48;
        const entrance = gsap.timeline({ paused: true });

        entrance
          .fromTo(
            medias,
            { clipPath: 'inset(0% 100% 0% 0% round 14px)' },
            {
              clipPath: 'inset(0% 0% 0% 0% round 14px)',
              duration: 1.5,
              ease: 'expo.inOut',
              stagger: 0.14,
              clearProps: 'clipPath',
            },
            0,
          )
          .from(
            projects,
            {
              x: dx,
              rotate: (projectIndex) => (projectIndex % 2 === 0 ? 1.4 : -1.4),
              duration: 1.5,
              ease: 'expo.out',
              stagger: 0.14,
              clearProps: 'transform',
            },
            0,
          )
          .from(
            ghosts,
            {
              xPercent: -50,
              opacity: 0,
              duration: 1.3,
              ease: 'expo.out',
              stagger: 0.14,
            },
            0.3,
          );

        projects.forEach((project, projectIndex) => {
          const lines = project.querySelectorAll(
            '.work__meta, .work__title, .work__desc, .work__tags span, .work__links a',
          );
          entrance.from(
            lines,
            {
              y: 28,
              opacity: 0,
              duration: 0.85,
              ease: 'power3.out',
              stagger: 0.045,
            },
            0.55 + projectIndex * 0.14,
          );
        });

        entrance.from(
          '.works-foot',
          { y: 26, opacity: 0, duration: 0.8, ease: 'power3.out' },
          0.7,
        );

        ScrollTrigger.create({
          trigger: section,
          start: window.innerWidth >= 1024 ? 'top 68%' : 'top 82%',
          animation: entrance,
          toggleActions: 'play none none reverse',
        });
      }

      if (reduced) setActive(0);

      // ── Desktop: galería horizontal anclada ──
      const mm = gsap.matchMedia();

      mm.add(
        '(min-width: 1024px) and (prefers-reduced-motion: no-preference)',
        () => {
          section.classList.add('is-pinned');
          const distance = () =>
            Math.max(0, track.scrollWidth - viewport.clientWidth);

          const nearestIndex = () => {
            const center =
              viewport.getBoundingClientRect().left + viewport.clientWidth / 2;
            let best = 0;
            let bestDistance = Infinity;
            projects.forEach((project, index) => {
              const rect = project.getBoundingClientRect();
              const gap = Math.abs(rect.left + rect.width / 2 - center);
              if (gap < bestDistance) {
                bestDistance = gap;
                best = index;
              }
            });
            return best;
          };

          activeTrigger = ScrollTrigger.create({
            trigger: section,
            start: 'top top',
            end: () => `+=${Math.max(1, distance())}`,
            pin: true,
            scrub: 1,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              gsap.set(track, { x: -distance() * self.progress });
              if (fill) fill.style.transform = `scaleX(${self.progress})`;
              setActive(nearestIndex());
            },
            onRefresh: (self) => {
              gsap.set(track, { x: -distance() * self.progress });
              setActive(nearestIndex(), false);
            },
          });

          gsap.set(track, { x: 0 });
          setActive(0, false);

          const onStepClick = (event: Event) => {
            const step = event.currentTarget as HTMLElement;
            const index = Number(step.dataset.step ?? 0);
            if (!activeTrigger) return;
            const project = projects[index];
            if (!project) return;
            const span = activeTrigger.end - activeTrigger.start;
            const center =
              viewport.getBoundingClientRect().left + viewport.clientWidth / 2;
            const rect = project.getBoundingClientRect();
            const delta = center - (rect.left + rect.width / 2);
            const progress = gsap.utils.clamp(
              0,
              1,
              activeTrigger.progress - delta / Math.max(1, distance()),
            );
            const top = activeTrigger.start + progress * span;
            const instance = lenis();
            if (instance) instance.scrollTo(top + 1, { duration: 1.1 });
            else window.scrollTo({ top: top + 1, behavior: 'smooth' });
          };
          steps.forEach((step) => step.addEventListener('click', onStepClick));

          return () => {
            section.classList.remove('is-pinned');
            activeTrigger?.kill();
            activeTrigger = undefined;
            steps.forEach((step) =>
              step.removeEventListener('click', onStepClick),
            );
            gsap.set(track, { clearProps: 'transform' });
            if (fill) fill.style.transform = 'scaleX(0)';
          };
        },
      );

      // ── Móvil: scroll horizontal nativo ──
      mm.add(
        '(max-width: 1023px) and (prefers-reduced-motion: no-preference)',
        () => {
          section.classList.add('is-native');
          let raf = 0;
          let firstUpdate = true;
          const update = () => {
            raf = 0;
            const center =
              viewport.getBoundingClientRect().left + viewport.clientWidth / 2;
            let best = 0;
            let bestDistance = Infinity;
            projects.forEach((project, index) => {
              const rect = project.getBoundingClientRect();
              const distance = Math.abs(rect.left + rect.width / 2 - center);
              if (distance < bestDistance) {
                bestDistance = distance;
                best = index;
              }
            });
            setActive(best, !firstUpdate);
            firstUpdate = false;
            const max = viewport.scrollWidth - viewport.clientWidth;
            if (fill) {
              fill.style.transform = `scaleX(${max > 0 ? viewport.scrollLeft / max : 0})`;
            }
          };
          const onScroll = () => {
            if (raf) return;
            raf = requestAnimationFrame(update);
          };
          viewport.addEventListener('scroll', onScroll, { passive: true });
          update();

          return () => {
            section.classList.remove('is-native');
            cancelAnimationFrame(raf);
            viewport.removeEventListener('scroll', onScroll);
          };
        },
      );

      // ── Distorsión WebGL al hover ──
      mm.add(
        '(min-width: 1024px) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
        () => {
          if (!glCanvas) return;

          let hovered: HTMLElement | null = null;
          let currentSrc = '';

          const resize = (media: HTMLElement) => {
            if (!distortion) return;
            distortion.resize(media.clientWidth, media.clientHeight);
          };

          const onMove = (event: PointerEvent) => {
            if (!hovered || !distortion) return;
            const rect = hovered.getBoundingClientRect();
            distortion.setPointer(
              (event.clientX - rect.left) / rect.width,
              1 - (event.clientY - rect.top) / rect.height,
            );
          };

          const enter = (media: HTMLElement, image: HTMLImageElement) => {
            if (!distortion) distortion = createProjectDistortion(glCanvas);
            hovered = media;
            const openBadge = media.querySelector('.work__open');
            media.insertBefore(glCanvas, openBadge);
            resize(media);

            const src = image.getAttribute('src') || '';
            const show = () => {
              if (hovered !== media || !distortion) return;
              resize(media);
              glCanvas.classList.add('is-on');
              distortion.setStrength(1);
              distortion.resume();
            };

            if (src !== currentSrc) {
              currentSrc = src;
              distortion.setTexture(src).then(show);
            } else {
              show();
            }
          };

          const leave = () => {
            hovered = null;
            glCanvas.classList.remove('is-on');
            distortion?.setStrength(0);
          };

          const listeners: Array<() => void> = [];

          projects.forEach((project) => {
            const media = project.querySelector<HTMLElement>('.work__media');
            const image = project.querySelector<HTMLImageElement>('.work__img');
            if (!media || !image) return;
            const enterHandler = () => enter(media, image);
            const leaveHandler = () => leave();
            media.addEventListener('pointerenter', enterHandler);
            media.addEventListener('pointermove', onMove);
            media.addEventListener('pointerleave', leaveHandler);
            listeners.push(() => {
              media.removeEventListener('pointerenter', enterHandler);
              media.removeEventListener('pointermove', onMove);
              media.removeEventListener('pointerleave', leaveHandler);
            });
          });

          return () => {
            leave();
            listeners.forEach((remove) => remove());
          };
        },
      );

      // ── Case study ──
      if (caseEl) {
        const onKeydown = (event: KeyboardEvent) => {
          if (!caseOpen) return;
          if (event.key === 'Escape') {
            event.preventDefault();
            closeCase();
            return;
          }
          if (event.key !== 'Tab' || !caseDialog) return;
          const focusable = Array.from(
            caseDialog.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
            ),
          );
          if (!focusable.length) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        };

        const openCase = (index: number) => {
          if (caseOpen) return;
          const project = projects[index];
          if (!project || !caseEl || !caseDialog) return;
          const title =
            project.querySelector('.work__title')?.textContent ?? '';
          const desc = project.querySelector('.work__desc')?.textContent ?? '';
          const tags = Array.from(project.querySelectorAll('.work__tags span'));
          const image = project.querySelector<HTMLImageElement>('.work__img');
          const demo = project.querySelector<HTMLAnchorElement>('[data-demo]');
          const code = project.querySelector<HTMLAnchorElement>('[data-code]');

          if (caseImage && image) {
            caseImage.src = image.src;
            caseImage.alt = image.alt;
          }
          if (caseTitle) caseTitle.textContent = title;
          if (caseDesc) caseDesc.textContent = desc;
          if (caseTags) {
            caseTags.innerHTML = '';
            tags.forEach((tag) => {
              const span = document.createElement('span');
              span.textContent = tag.textContent;
              caseTags.appendChild(span);
            });
          }
          if (caseYear) caseYear.textContent = project.dataset.year || '2025';
          if (caseStatus)
            caseStatus.textContent = project.dataset.status || 'LIVE';
          if (caseStack) {
            caseStack.textContent = tags
              .slice(0, 2)
              .map((tag) => tag.textContent)
              .filter(Boolean)
              .join(' / ');
          }
          if (caseIndex) {
            caseIndex.textContent = String(index + 1).padStart(2, '0');
          }
          if (caseDemo && demo) caseDemo.href = demo.href;
          if (caseCode && code) caseCode.href = code.href;

          const active = document.activeElement;
          lastFocus =
            active instanceof HTMLElement && active !== document.body
              ? active
              : project.querySelector<HTMLElement>('.work__media');
          caseOpen = true;
          caseEl.classList.add('is-open');
          caseEl.setAttribute('aria-hidden', 'false');
          [main, hud, skipLink].forEach((el) => el?.setAttribute('inert', ''));
          caseClose?.focus({ preventScroll: true });
          lenis()?.stop();
          glCanvas?.classList.remove('is-on');
          distortion?.setStrength(0);

          if (!reduced) {
            gsap.fromTo(
              caseEl.querySelector('.case__backdrop'),
              { opacity: 0 },
              { opacity: 1, duration: 0.35, ease: 'power2.out' },
            );
            gsap.fromTo(
              caseDialog,
              { opacity: 0, y: 30, scale: 0.975 },
              {
                opacity: 1,
                y: 0,
                scale: 1,
                duration: 0.55,
                ease: 'expo.out',
                onComplete: () => caseClose?.focus({ preventScroll: true }),
              },
            );
          }
        };

        const closeCase = () => {
          if (!caseOpen || !caseEl) return;
          caseOpen = false;
          const finish = () => {
            caseEl.classList.remove('is-open');
            caseEl.setAttribute('aria-hidden', 'true');
            [main, hud, skipLink].forEach((el) => el?.removeAttribute('inert'));
            lenis()?.start();
            lastFocus?.focus({ preventScroll: true });
          };

          if (reduced) {
            finish();
          } else {
            gsap.to(caseEl.querySelector('.case__backdrop'), {
              opacity: 0,
              duration: 0.25,
              ease: 'power2.in',
            });
            gsap.to(caseDialog, {
              opacity: 0,
              y: 20,
              scale: 0.985,
              duration: 0.3,
              ease: 'power2.in',
              onComplete: finish,
            });
          }
        };

        const onClick = (event: Event) => {
          const target = event.target as Element | null;
          const closeButton = target?.closest?.('[data-case-close]');
          if (closeButton) {
            closeCase();
            return;
          }
          const trigger = target?.closest?.(
            '[data-case]',
          ) as HTMLElement | null;
          if (!trigger) return;
          const project = trigger.closest<HTMLElement>('.work');
          if (!project) return;
          openCase(Number(project.dataset.index ?? 0));
        };

        document.addEventListener('click', onClick);
        document.addEventListener('keydown', onKeydown);
        removeCaseListeners = () => {
          document.removeEventListener('click', onClick);
          document.removeEventListener('keydown', onKeydown);
          [main, hud, skipLink].forEach((el) => el?.removeAttribute('inert'));
        };
      }

      ScrollTrigger.create({
        trigger: section,
        start: 'top bottom',
        end: 'bottom top',
        onToggle: (self) =>
          section.classList.toggle('is-paused', !self.isActive),
      });
    }, section);

    // Añade metadata a las tarjetas para el modal
    projects.forEach((project) => {
      const card = project as HTMLElement;
      const year = card.querySelector('.work__meta span:nth-child(2)');
      const status = card.querySelector('.work__status');
      card.dataset.year = year?.textContent?.trim() || '';
      card.dataset.status = status?.textContent?.trim() || '';
    });

    window.addEventListener(
      'astro:before-swap',
      () => {
        distortion?.dispose();
        distortion = null;
        removeCaseListeners?.();
        removeCaseListeners = undefined;
        ctx?.revert();
        ctx = undefined;
        inited = false;
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', initProjects);
  if (document.readyState !== 'loading') initProjects();
  else document.addEventListener('DOMContentLoaded', initProjects);
</script>

