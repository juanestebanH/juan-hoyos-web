---
const isEn = Astro.url.pathname.startsWith('/en');
const lang = isEn ? 'en' : 'es';
---

<div class="viajero-hud" data-lang={lang} aria-hidden="true">
  <div class="vh-scope">
    <span class="vh-grid"></span>
    <span class="vh-ring"></span>
    <span class="vh-ring vh-ring--dash"></span>
    <span class="vh-cross vh-cross--x"></span>
    <span class="vh-cross vh-cross--y"></span>
    <span class="vh-section">
      <span class="vh-index">S-01</span>
      <span class="vh-label">{isEn ? 'Start' : 'Inicio'}</span>
    </span>
    <span class="vh-coords">x 0000 · y 00000</span>
    <span class="vh-bar"><i></i></span>
  </div>
</div>

<style>
  .viajero-hud {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    opacity: 0;
    will-change: transform, opacity;
  }

  .vh-scope {
    position: absolute;
    left: -74px;
    top: -74px;
    width: 148px;
    height: 148px;
    border-radius: 50%;
    color: #fff;
    font-family: var(--font-mono), 'JetBrains Mono', monospace;
    --vh-line: rgba(255, 255, 255, 0.18);
    --vh-soft: rgba(255, 255, 255, 0.09);
    --vh-grid: rgba(255, 255, 255, 0.055);
    --vh-text: rgba(255, 255, 255, 0.66);
    --vh-dim: rgba(255, 255, 255, 0.4);
  }

  .vh-grid {
    position: absolute;
    inset: 10px;
    border-radius: 50%;
    background-image:
      linear-gradient(var(--vh-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--vh-grid) 1px, transparent 1px);
    background-size: 16px 16px;
    background-position: center;
    -webkit-mask-image: radial-gradient(
      circle at center,
      #000 45%,
      transparent 72%
    );
    mask-image: radial-gradient(circle at center, #000 45%, transparent 72%);
  }

  .vh-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--vh-line);
    -webkit-mask-image: conic-gradient(
      from 0deg,
      #000 0 78%,
      transparent 78% 81%,
      #000 81% 94%,
      transparent 94% 100%
    );
    mask-image: conic-gradient(
      from 0deg,
      #000 0 78%,
      transparent 78% 81%,
      #000 81% 94%,
      transparent 94% 100%
    );
  }

  .vh-ring--dash {
    inset: 7px;
    border: 1px dashed var(--vh-soft);
    -webkit-mask-image: none;
    mask-image: none;
    animation: vh-spin 26s linear infinite;
  }

  .vh-cross {
    position: absolute;
    background: var(--vh-soft);
  }

  .vh-cross--x {
    left: 13px;
    right: 13px;
    top: 50%;
    height: 1px;
    margin-top: -0.5px;
    -webkit-mask-image: linear-gradient(
      90deg,
      #000 0 46%,
      transparent 46% 54%,
      #000 54% 100%
    );
    mask-image: linear-gradient(
      90deg,
      #000 0 46%,
      transparent 46% 54%,
      #000 54% 100%
    );
  }

  .vh-cross--y {
    top: 13px;
    bottom: 13px;
    left: 50%;
    width: 1px;
    margin-left: -0.5px;
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0 46%,
      transparent 46% 54%,
      #000 54% 100%
    );
    mask-image: linear-gradient(
      180deg,
      #000 0 46%,
      transparent 46% 54%,
      #000 54% 100%
    );
  }

  .vh-section {
    position: absolute;
    left: 50%;
    top: -25px;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--vh-text);
  }

  .vh-index {
    color: var(--vh-dim);
    letter-spacing: 0.14em;
  }

  .vh-coords {
    position: absolute;
    left: 50%;
    bottom: -25px;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0.12em;
    color: var(--vh-dim);
    font-variant-numeric: tabular-nums;
  }

  .vh-bar {
    position: absolute;
    left: 50%;
    bottom: 11px;
    width: 40px;
    height: 1px;
    transform: translateX(-50%);
    background: var(--vh-soft);
    overflow: hidden;
  }

  .vh-bar i {
    display: block;
    width: 0%;
    height: 100%;
    background: var(--vh-section, #ffffff);
  }

  :global(html.light) .vh-scope {
    color: #000;
    --vh-line: rgba(0, 0, 0, 0.22);
    --vh-soft: rgba(0, 0, 0, 0.1);
    --vh-grid: rgba(0, 0, 0, 0.05);
    --vh-text: rgba(0, 0, 0, 0.66);
    --vh-dim: rgba(0, 0, 0, 0.42);
  }

  @keyframes vh-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    .viajero-hud {
      display: none;
    }
  }
</style>
