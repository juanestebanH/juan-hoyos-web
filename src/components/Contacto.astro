---
import { Icon } from 'astro-icon/components';
import { es } from '../i18n/es';
import { en } from '../i18n/en';

const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const t = lang === 'en' ? en : es;

const socialLinks = [
  {
    name: 'GitHub',
    icon: 'mdi:github',
    href: 'https://github.com/juanestebanH',
  },
  {
    name: 'LinkedIn',
    icon: 'mdi:linkedin',
    href: 'https://linkedin.com/in/juan-esteban-hoyos-0b60912b4',
  },
];

const email = 'juanestebanhoyos.dev@gmail.com';
const cv = lang === 'en' ? '/cv-juan-hoyos-en.pdf' : '/cv-juan-hoyos-es.pdf';

interface Props {
  title: string;
  subtitle: string;
  description: string;
  btn_email: string;
  formulario_nombre: string;
  formulario_email: string;
  formulario_mensaje: string;
}
const {
  title,
  subtitle,
  description,
  btn_email,
  formulario_nombre,
  formulario_email,
  formulario_mensaje,
} = Astro.props;
---

<div
  id="toast-container"
  class="contact-toasts"
  aria-live="polite"
  aria-atomic="false"
>
</div>

<section id="contacto" class="contact-section">
  <div class="contact-portal" aria-hidden="true">
    <span class="contact-ring contact-ring--1"></span>
    <span class="contact-ring contact-ring--2"></span>
    <span class="contact-ring contact-ring--3"></span>
    <span class="contact-core"></span>
  </div>
  <div class="contact-grid" aria-hidden="true"></div>

  <div class="contact-wrap">
    <header class="contact-head">
      <div class="contact-head__meta">
        <span class="act-kicker">{t.contact.kicker}</span>
        <span class="contact-readout">{title} <span>06</span></span>
      </div>

      <h2 class="contact-title">{subtitle}</h2>

      <div class="contact-head__foot">
        <p class="contact-desc">{description}</p>
        <a class="contact-mail" href={`mailto:${email}`}>
          <span>{email}</span>
          <Icon name="mdi:arrow-top-right" class="contact-mail__icon" />
        </a>
      </div>
    </header>

    <div class="contact-layout">
      <div class="contact-left">
        <div class="contact-facts">
          <div>
            <span>{t.contact.local_time}</span>
            <strong id="contact-clock">--:--</strong>
          </div>
          <div>
            <span>{t.contact.availability_label}</span>
            <strong class="contact-facts__live">
              <i aria-hidden="true"></i>
              {t.contact.availability}
            </strong>
          </div>
        </div>

        <div class="contact-links">
          <span class="contact-links__label">{t.contact.socials}</span>
          <div class="contact-socials">
            {
              socialLinks.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-card"
                >
                  <Icon name={social.icon} class="social-icon" />
                  <span>{social.name}</span>
                  <Icon name="mdi:arrow-top-right" class="social-arrow" />
                </a>
              ))
            }
            <a href={cv} download class="social-card social-card--cv">
              <Icon name="mdi:file-download-outline" class="social-icon" />
              <span>{t.contact.cv}</span>
              <Icon name="mdi:arrow-down" class="social-arrow" />
            </a>
          </div>
        </div>
      </div>

      <div class="contact-tilt">
        <div class="contact-card">
          <div class="contact-spotlight" aria-hidden="true"></div>
          <div class="contact-flash" aria-hidden="true"></div>

          <div class="contact-card__head">
            <span class="contact-card__title">{t.contact.form_title}</span>
            <span class="contact-card__note">{t.contact.form_note}</span>
          </div>

          <form id="contact-form" class="contact-form" novalidate>
            <div class="contact-field">
              <input
                id="cf-name"
                type="text"
                name="name"
                required
                placeholder=" "
                autocomplete="name"
                class="contact-input"
              />
              <label for="cf-name" class="contact-label">{formulario_nombre}</label>
              <span class="contact-line"></span>
            </div>

            <div class="contact-field">
              <input
                id="cf-email"
                type="email"
                name="email"
                required
                placeholder=" "
                autocomplete="email"
                class="contact-input"
              />
              <label for="cf-email" class="contact-label">{formulario_email}</label>
              <span class="contact-line"></span>
            </div>

            <div class="contact-field">
              <textarea
                id="cf-message"
                name="message"
                rows="4"
                required
                placeholder=" "
                class="contact-input contact-textarea"></textarea>
              <label for="cf-message" class="contact-label">{formulario_mensaje}</label>
              <span class="contact-line"></span>
            </div>

            <button type="submit" class="contact-btn">
              <span>{btn_email}</span>
              <span class="contact-btn-icon">
                <Icon name="mdi:send" />
              </span>
            </button>

            <p id="contact-status" class="contact-status" role="status"></p>
          </form>

          <a class="contact-direct" href={`mailto:${email}`}>
            <Icon name="mdi:email-outline" />
            {t.contact.direct}
          </a>
        </div>
      </div>
    </div>

    <footer class="contact-foot">
      <span>© 2026 Juan Esteban Hoyos</span>
      <span class="contact-foot__mid">{t.contact.footer}</span>
      <a href="#inicio" aria-label={t.contact.back_top}>
        {t.contact.back_top}
        <Icon name="mdi:arrow-up" />
      </a>
    </footer>
  </div>
</section>

<script>
  import emailjs from '@emailjs/browser';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { splitMaskWords } from '../util/text';

  gsap.registerPlugin(ScrollTrigger);

  type ToastType = 'success' | 'error' | 'loading';

  function showToast(message: string, type: ToastType = 'success'): HTMLElement | null {
    const container = document.getElementById('toast-container');
    if (!container) return null;
    const toast = document.createElement('div');
    toast.className = `contact-toast contact-toast--${type}`;
    toast.textContent = message;
    container.appendChild(toast);
    gsap.to(toast, { opacity: 1, x: 0, duration: 0.35, ease: 'power3.out' });
    return toast;
  }

  function dismissToast(toast: HTMLElement | null, delay = 0) {
    if (!toast) return;
    gsap.to(toast, {
      opacity: 0,
      x: 30,
      duration: 0.3,
      delay,
      ease: 'power3.in',
      onComplete: () => toast.remove(),
    });
  }

  function initContact() {
    const section = document.getElementById('contacto');
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!section || !form || section.dataset.inited === 'true') return;
    section.dataset.inited = 'true';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clock = document.getElementById('contact-clock');
    const status = document.getElementById('contact-status');
    const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
    const copy =
      lang === 'en'
        ? {
            sending: 'Sending message…',
            success: 'Message sent. I will get back to you soon.',
            error: 'Something went wrong. Please try again or email me directly.',
            invalid: 'Please complete all fields with a valid email.',
          }
        : {
            sending: 'Enviando mensaje…',
            success: 'Mensaje enviado. Te responderé pronto.',
            error: 'Algo falló. Inténtalo de nuevo o escríbeme directo.',
            invalid: 'Completa todos los campos con un correo válido.',
          };

    const updateClock = () => {
      if (!clock) return;
      clock.textContent = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'es-CO', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZone: 'America/Bogota',
      }).format(new Date());
    };
    updateClock();
    const clockTimer = window.setInterval(updateClock, 30_000);

    const titleWords = splitMaskWords(section.querySelector('.contact-title'));

    const ctx = gsap.context((self) => {
      if (!reduced) {
        gsap.from(titleWords, {
          yPercent: 115,
          duration: 1,
          stagger: 0.07,
          ease: 'expo.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 94%',
            end: 'top 52%',
            scrub: 1,
          },
        });

        gsap.from('.contact-head__meta, .contact-desc, .contact-mail', {
          y: 52,
          x: (itemIndex) => (itemIndex % 2 === 0 ? 22 : -18),
          scale: 0.97,
          opacity: 0,
          duration: 0.8,
          stagger: 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 92%',
            end: 'top 56%',
            scrub: 1,
          },
        });

        gsap.from('.contact-facts > div, .contact-links', {
          y: 48,
          scale: 0.97,
          opacity: 0,
          duration: 0.7,
          stagger: 0.09,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '.contact-facts',
            start: 'top 96%',
            end: 'top 64%',
            scrub: 1,
          },
        });

        gsap.from('.contact-tilt', {
          y: 110,
          scale: 0.94,
          rotateX: 6,
          transformPerspective: 1000,
          opacity: 0,
          filter: 'blur(10px)',
          duration: 1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '.contact-tilt',
            start: 'top 96%',
            end: 'top 54%',
            scrub: 1,
          },
        });

        gsap.from('.contact-foot', {
          opacity: 0,
          y: 36,
          duration: 0.7,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '.contact-foot',
            start: 'top 100%',
            end: 'top 82%',
            scrub: 1,
          },
        });
      }

      ScrollTrigger.create({
        trigger: section,
        start: 'top bottom',
        end: 'bottom top',
        onToggle: (self) => section.classList.toggle('is-paused', !self.isActive),
      });

      const card = section.querySelector<HTMLElement>('.contact-card');
      if (card && !reduced && window.matchMedia('(pointer: fine)').matches) {
        const onMove = (event: PointerEvent) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
          card.style.setProperty('--my', `${event.clientY - rect.top}px`);
        };
        card.addEventListener('pointermove', onMove);
        self.add(() => card.removeEventListener('pointermove', onMove));
      }
    }, section);

    const onSubmit = async (event: Event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        if (status) status.textContent = copy.invalid;
        form.querySelector<HTMLElement>(':invalid')?.focus({ preventScroll: true });
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('.contact-btn');
      const flash = section.querySelector<HTMLElement>('.contact-flash');
      if (button) {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
      }
      if (status) status.textContent = copy.sending;

      const loadingToast = showToast(copy.sending, 'loading');

      try {
        await emailjs.sendForm(
          'service_27ecmm7',
          'template_1ujbt2e',
          form,
          '8XOsc6JgD28fsiEwo',
        );

        dismissToast(loadingToast);
        showToast(copy.success, 'success');
        if (status) status.textContent = copy.success;
        form.reset();

        if (flash) {
          gsap.fromTo(flash, { opacity: 0.85 }, { opacity: 0, duration: 1, ease: 'power2.out' });
        }

        window.dispatchEvent(new CustomEvent('world:pulse'));
      } catch {
        dismissToast(loadingToast);
        showToast(copy.error, 'error');
        if (status) status.textContent = copy.error;
        if (!reduced) {
          gsap.fromTo(
            form,
            { x: -6 },
            { x: 6, repeat: 5, yoyo: true, duration: 0.05, clearProps: 'x' },
          );
        }
      } finally {
        if (button) {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        }
      }
    };

    form.addEventListener('submit', onSubmit);

    const teardown = () => {
      window.clearInterval(clockTimer);
      form.removeEventListener('submit', onSubmit);
      ctx.revert();
      section.dataset.inited = 'false';
    };

    document.addEventListener('astro:before-swap', teardown, { once: true });
  }

  document.addEventListener('astro:page-load', initContact);
  initContact();
</script>

<style>
  #contacto {
    --contact-accent: var(--chapter-accent, var(--color-blanco));
    --contact-glass: color-mix(in srgb, var(--color-neutro) 58%, transparent);
    --contact-border: color-mix(in srgb, var(--color-blanco) 12%, transparent);
  }

  .contact-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    padding: clamp(3rem, 7vh, 5rem) clamp(1.25rem, 5vw, 4.5rem) 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-blanco) 8%, transparent);
  }

  .contact-toasts {
    position: fixed;
    top: 5.5rem;
    right: clamp(1rem, 4vw, 2rem);
    z-index: 80;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    pointer-events: none;
  }

  :global(.contact-toast) {
    min-width: 15rem;
    max-width: min(22rem, 82vw);
    padding: 0.75rem 1rem;
    border-radius: 0.7rem;
    border: 1px solid var(--contact-border);
    border-left: 2px solid var(--chapter-accent);
    background: color-mix(in srgb, var(--color-neutro) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--color-blanco);
    font-size: 0.78rem;
    line-height: 1.4;
    opacity: 0;
    transform: translateX(40px);
    pointer-events: auto;
  }

  :global(.contact-toast--error) {
    border-left-style: dashed;
    border-left-color: color-mix(in srgb, var(--color-blanco) 45%, transparent);
  }

  :global(.contact-toast--success) {
    border-left-color: var(--color-blanco);
  }

  /* ── Portal ── */
  .contact-portal {
    position: absolute;
    z-index: -1;
    top: 42%;
    left: 50%;
    width: min(60vw, 46rem);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0.7;
  }

  .contact-ring {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--contact-accent) 16%, transparent);
    animation: contact-spin 34s linear infinite;
  }

  .contact-ring--2 {
    inset: 12%;
    border-style: dashed;
    animation-duration: 26s;
    animation-direction: reverse;
  }

  .contact-ring--3 {
    inset: 25%;
    animation-duration: 18s;
    opacity: 0.7;
  }

  .contact-core {
    position: absolute;
    inset: 31%;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--contact-accent) 22%, transparent),
      transparent 68%
    );
    filter: blur(24px);
    animation: contact-breathe 9s ease-in-out infinite;
  }

  @keyframes contact-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes contact-breathe {
    0%, 100% { opacity: 0.55; transform: scale(0.94); }
    50% { opacity: 1; transform: scale(1.06); }
  }

  .contact-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    opacity: 0.35;
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-blanco) 5%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-blanco) 5%, transparent) 1px,
        transparent 1px
      );
    background-size: 5rem 5rem;
    mask-image: radial-gradient(80% 80% at 50% 40%, #000, transparent 80%);
    -webkit-mask-image: radial-gradient(80% 80% at 50% 40%, #000, transparent 80%);
  }

  .contact-wrap {
    position: relative;
    z-index: 2;
    width: min(100%, 84rem);
    margin-inline: auto;
  }

  .contact-head__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.7rem;
  }

  .contact-readout {
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gris-oscuro);
  }

  .contact-readout span {
    margin-left: 0.5rem;
    color: var(--contact-accent);
  }

  .contact-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--section-title-size);
    font-weight: 900;
    line-height: var(--section-title-leading);
    letter-spacing: var(--section-title-tracking);
    text-transform: uppercase;
    color: var(--color-blanco);
    overflow: hidden;
  }

  .contact-head__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.2rem 3rem;
    margin-top: clamp(1rem, 2.5vh, 1.5rem);
    padding-bottom: clamp(1rem, 2.5vh, 1.5rem);
    border-bottom: 1px solid color-mix(in srgb, var(--color-blanco) 9%, transparent);
  }

  .contact-desc {
    max-width: 32rem;
    margin: 0;
    font-size: clamp(0.92rem, 1.2vw, 1.05rem);
    line-height: 1.6;
    color: var(--color-gris-claro);
  }

  .contact-mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-blanco);
    font-family: var(--font-mono);
    font-size: clamp(0.65rem, 1vw, 0.78rem);
    letter-spacing: 0.04em;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--contact-accent) 55%, transparent);
    padding-bottom: 0.2rem;
    transition: color 0.3s ease;
  }

  .contact-mail:hover {
    color: var(--contact-accent);
  }

  .contact-mail__icon {
    width: 0.9rem;
    height: 0.9rem;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(1.25rem, 3vh, 2rem);
  }

  .contact-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
    max-width: 36rem;
  }

  .contact-facts > div {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in srgb, var(--color-blanco) 9%, transparent);
  }

  .contact-facts > div:last-child {
    grid-column: 1 / -1;
  }

  .contact-facts span {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gris-oscuro);
  }

  .contact-facts strong {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-blanco);
    font-variant-numeric: tabular-nums;
  }

  .contact-facts__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .contact-facts__live i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-blanco);
    box-shadow: 0 0 12px color-mix(in srgb, var(--color-blanco) 55%, transparent);
    animation: contact-live 2s ease-in-out infinite;
  }

  @keyframes contact-live {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .contact-links {
    margin-top: 1.6rem;
  }

  .contact-links__label {
    display: block;
    margin-bottom: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gris-oscuro);
  }

  .contact-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 36rem;
  }

  .social-card {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-blanco) 12%, transparent);
    background: color-mix(in srgb, var(--color-neutro) 35%, transparent);
    color: var(--color-gris-claro);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .social-card:hover {
    color: var(--color-blanco);
    border-color: var(--contact-accent);
    transform: translateY(-2px);
  }

  .social-icon,
  .social-arrow {
    width: 0.9rem;
    height: 0.9rem;
  }

  .social-arrow {
    opacity: 0.4;
  }

  .contact-tilt {
    perspective: 1300px;
  }

  .contact-card {
    position: relative;
    padding: clamp(1.2rem, 2.2vw, 1.6rem);
    border-radius: 1rem;
    border: 1px solid var(--contact-border);
    background:
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--color-blanco) 5%, transparent),
        transparent 45%
      ),
      var(--contact-glass);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    overflow: hidden;
    transform-style: preserve-3d;
    box-shadow: 0 40px 100px -50px rgba(0, 0, 0, 0.9);
  }

  .contact-spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      16rem circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--contact-accent) 14%, transparent),
      transparent 70%
    );
    transition: opacity 0.4s ease;
  }

  .contact-card:hover .contact-spotlight {
    opacity: 1;
  }

  .contact-flash {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--contact-accent);
    opacity: 0;
    pointer-events: none;
  }

  .contact-card__head {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .contact-card__title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-blanco);
  }

  .contact-card__note {
    font-family: var(--font-mono);
