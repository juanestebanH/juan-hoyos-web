---
import { Icon } from 'astro-icon/components';
import { experiences } from '../data/experiences';
import { es } from '../i18n/es';
import { en } from '../i18n/en';

interface Props {
  title: string;
  descriptions: Record<string, string>;
  labels?: Record<string, string>;
}

const { title, descriptions, labels = {} } = Astro.props;
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const t = lang === 'en' ? en : es;

const experiencesWithDesc = experiences.map((e) => ({
  ...e,
  year: e.period.split('-')[0].trim(),
  label: labels[e.type] ?? '',
  description: descriptions[e.id] ?? '',
}));
---

<section id="experiencia" class="exp-section relative overflow-hidden py-24 md:py-32 px-6">
  <div class="exp-aurora" aria-hidden="true"></div>

  <div class="exp-inner relative z-10 mx-auto max-w-7xl">
    <!-- Título -->
    <span class="act-kicker exp-kicker">{t.experience.kicker}</span>
    <div class="exp-heading">
      <h2 class="timeline-title text-blanco text-start overflow-hidden">
        {title}
      </h2>
      <span class="exp-readout">{t.experience.readout}</span>
    </div>

    <!-- Timeline en profundidad -->
    <div class="exp-track relative mx-auto max-w-5xl">
      <div class="exp-rail" aria-hidden="true"></div>

      {
        experiencesWithDesc.map((exp) => (
          <article class="exp-item" style={`--exp-color:${exp.color}`}>
            <span class="exp-year" aria-hidden="true">
              {exp.year}
            </span>

            <div class="exp-node">
              <Icon name={exp.icon} class="w-6 h-6 text-white" />
            </div>

            <div class="exp-card">
              <div class="exp-card__head">
                <span class="exp-tag">{exp.label}</span>
                <span class="exp-period">{exp.period}</span>
              </div>
              <h3 class="exp-title text-blanco">{exp.title}</h3>
              <p class="exp-org">{exp.organization}</p>
              <p class="exp-desc">{exp.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  #experiencia {
    --exp-accent: var(--chapter-accent, var(--color-blanco));
    --spine: 1.5rem;
    --node: 3rem;
    --indent: 4rem;
  }

  .exp-kicker {
    margin-bottom: 1.2rem;
  }

  .exp-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(3.5rem, 9vw, 6rem);
  }

  .exp-heading .timeline-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--section-title-size);
    font-weight: 900;
    line-height: var(--section-title-leading);
    letter-spacing: var(--section-title-tracking);
    text-transform: uppercase;
    color: var(--color-blanco);
  }

  .exp-readout {
    padding-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gris-oscuro);
    white-space: nowrap;
  }

  /* ── Aurora ambiente ─────────────────────────────── */
  .exp-aurora {
    position: absolute;
    inset: -10% -5%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        42% 38% at 50% 38%,
        color-mix(in srgb, var(--exp-accent) 8%, transparent),
        transparent 70%
      ),
      radial-gradient(
        30% 26% at 78% 72%,
        color-mix(in srgb, var(--exp-accent) 4%, transparent),
        transparent 72%
      );
    filter: blur(34px);
    animation: exp-breathe 10s ease-in-out infinite;
    will-change: transform, opacity;
  }

  #experiencia.is-paused .exp-aurora {
    animation-play-state: paused;
  }

  @keyframes exp-breathe {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }

  /* ── Estructura / profundidad 3D ─────────────────── */
  .exp-inner {
    perspective: 1400px;
  }

  .exp-track {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding-left: 4rem;
    transform-style: preserve-3d;
  }

  .exp-item {
    position: relative;
    transform-style: preserve-3d;
    will-change: transform, opacity, filter;
  }

  /* Rail */
  .exp-rail {
    position: absolute;
    left: var(--spine);
    top: 0;
    width: 1px;
    height: 100%;
    transform: translateX(-50%) scaleY(0);
    transform-origin: top center;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--exp-accent) 65%, transparent) 10%,
      color-mix(in srgb, var(--exp-accent) 28%, transparent) 75%,
      transparent
    );
    z-index: 0;
  }

  /* Nodo */
  .exp-node {
    position: absolute;
    left: calc(var(--spine) - var(--node) / 2 - var(--indent));
    top: 1.5rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--node);
    height: var(--node);
    border-radius: 9999px;
    background: radial-gradient(
      circle at 35% 30%,
      color-mix(in srgb, var(--exp-color) 65%, #ffffff),
      var(--exp-color)
    );
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-blanco) 14%, transparent),
      0 0 40px -12px color-mix(in srgb, var(--exp-accent) 55%, transparent);
  }

  /* Año gigante (outline) */
  .exp-year {
    position: absolute;
    top: -1rem;
    right: 0;
    z-index: 1;
    font-size: clamp(3.25rem, 12vw, 6rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-blanco) 14%, transparent);
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }

  /* Tarjeta */
  .exp-card {
    position: relative;
    z-index: 2;
    padding: 1.75rem 1.9rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-blanco) 14%, transparent);
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--color-neutro) 94%, transparent),
      color-mix(in srgb, var(--color-neutro) 82%, transparent)
    );
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0
      color-mix(in srgb, var(--color-blanco) 6%, transparent);
    transition:
      border-color 0.5s ease,
      box-shadow 0.5s ease;
  }

  .exp-item.is-active .exp-card {
    border-color: color-mix(in srgb, var(--exp-accent) 45%, transparent);
    box-shadow: 0 0 70px -28px
      color-mix(in srgb, var(--exp-accent) 55%, transparent);
  }

  .exp-card__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .exp-tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--exp-accent);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--exp-accent) 30%, transparent);
    background: color-mix(in srgb, var(--exp-accent) 8%, transparent);
  }

  .exp-period {
    margin-left: auto;
    font-size: 0.85rem;
    color: var(--color-gris-oscuro);
    font-variant-numeric: tabular-nums;
  }

  .exp-title {
    color: var(--color-blanco);
  }

  .exp-org {
    margin-top: 0.35rem;
    margin-bottom: 0.9rem;
    color: var(--color-secondary);
    font-size: 1rem;
  }

  .exp-desc {
    color: var(--color-gris-claro);
  }

  @media (min-width: 768px) {
    #experiencia {
      --spine: 1.75rem;
      --node: 3.5rem;
      --indent: 5rem;
    }

    .exp-track {
      padding-left: 5rem;
      gap: 6rem;
    }

    .exp-card {
      padding: 2.25rem 2.5rem;
    }

    .exp-node {
      top: 2rem;
    }
  }

  @media (max-width: 640px) {
    .exp-readout {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-aurora {
      animation: none;
    }

    .exp-rail {
      transform: translateX(-50%) scaleY(1);
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { animateTitleChars } from '../util/animations';

  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context | undefined;

  function initExperiencia() {
    const section = document.querySelector<HTMLElement>('#experiencia');
    if (!section || section.dataset.inited === 'true') return;
    section.dataset.inited = 'true';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isSmall = window.matchMedia('(max-width: 768px)').matches;

    ctx = gsap.context(() => {
      animateTitleChars('.timeline-title');

      const items = gsap.utils.toArray<HTMLElement>('.exp-item', section);
      const rail = section.querySelector<HTMLElement>('.exp-rail');
      const aurora = section.querySelector<HTMLElement>('.exp-aurora');

      // Accesibilidad: sin movimiento, todo visible
      if (reduced) {
        items.forEach((item) => item.classList.add('is-active'));
        return;
      }

      // Rail que se dibuja con el scroll
      if (rail) {
        gsap.fromTo(
          rail,
          { scaleY: 0 },
          {
            scaleY: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: section,
              start: 'top 80%',
              end: 'bottom 80%',
              scrub: true,
            },
          },
        );
      }

      // La aurora deriva con el scroll
      if (aurora) {
        gsap.fromTo(
          aurora,
          { yPercent: -14 },
          {
            yPercent: 14,
            ease: 'none',
            scrollTrigger: {
              trigger: section,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
            },
          },
        );
      }

      // Pausa la animación de la aurora fuera del viewport
      ScrollTrigger.create({
        trigger: section,
        start: 'top bottom',
        end: 'bottom top',
        onToggle: (self) => section.classList.toggle('is-paused', !self.isActive),
      });

      // Profundidad: fichas que vienen del fondo, se leen en el centro y salen suave
      const farZ = isSmall ? -460 : -760;
      const nearZ = isSmall ? 150 : 240;
      const blurFar = isSmall ? 9 : 16;

      items.forEach((item) => {
        const depth = gsap.timeline({
          scrollTrigger: {
            trigger: item,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        });

        // Entrada: del fondo al foco (rápida, ~30% del recorrido)
        depth.fromTo(
          item,
          { z: farZ, autoAlpha: 0, scale: 0.84, filter: `blur(${blurFar}px)` },
          { z: 0, autoAlpha: 1, scale: 1, filter: 'blur(0px)', duration: 0.3, ease: 'power2.out' },
        );
        // Meseta: nítido y opaco ~45% del scroll (ventana de lectura)
        depth.to(item, {
          z: 0,
          autoAlpha: 1,
          scale: 1,
          filter: 'blur(0px)',
          duration: 0.45,
        });
        // Salida suave: nunca ilegible (opacity mín 0.7, blur máx 2px)
        depth.to(item, {
          z: nearZ,
          autoAlpha: 0.7,
          scale: 1.03,
          filter: 'blur(2px)',
          duration: 0.25,
          ease: 'power2.in',
        });

        // Estado activo (glow) mientras el hito cruza el centro
        ScrollTrigger.create({
          trigger: item,
          start: 'top 70%',
          end: 'bottom 30%',
          onToggle: (self) => item.classList.toggle('is-active', self.isActive),
        });

        // Año con parallax
        const year = item.querySelector<HTMLElement>('.exp-year');
        if (year) {
          gsap.fromTo(
            year,
            { yPercent: 35 },
            {
              yPercent: -12,
              ease: 'none',
              scrollTrigger: {
                trigger: item,
                start: 'top bottom',
                end: 'bottom top',
                scrub: true,
              },
            },
          );
        }

        // Nodo con rebote
        const node = item.querySelector<HTMLElement>('.exp-node');
        if (node) {
          gsap.from(node, {
            scale: 0,
            autoAlpha: 0,
            duration: 0.5,
            ease: 'back.out(2)',
            scrollTrigger: {
              trigger: item,
              start: 'top 74%',
              toggleActions: 'play none none reverse',
            },
          });
        }
      });
    }, section);

    window.addEventListener(
      'astro:before-swap',
      () => {
        ctx?.revert();
        ctx = undefined;
        section.dataset.inited = 'false';
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', initExperiencia);
  initExperiencia();
</script>
