---
import { Icon } from 'astro-icon/components';

interface Props {
  subtitle: string;
  description: string;
  badge: string;
  btn_linkedin: string;
  btn_cv: string;
  cv_path: string;
  scroll_label: string;
}
const { subtitle, description, badge, btn_linkedin, btn_cv, cv_path, scroll_label } =
  Astro.props;
---

<section
  id="inicio"
  class="min-h-screen relative flex flex-col overflow-hidden grid-bg"
>
  <canvas
    id="starsCanvas"
    class="absolute inset-0 z-0 w-full h-full pointer-events-none"
    aria-hidden="true"></canvas>

  <!-- Ambient Vignette -->
  <div class="hero-vignette absolute inset-0 pointer-events-none z-10"></div>

  <div
    class="hero-content relative z-20 flex-1 flex flex-col items-center justify-center text-center px-6 max-w-4xl mx-auto w-full"
    style="padding-top: var(--hero-title-h, 6rem)"
  >
    <div class="hero-parallax flex flex-col items-center">
      <h1 class="hero-name text-6xl sm:text-8xl md:text-9xl font-black tracking-tighter uppercase leading-none mb-6 text-blanco select-none title-drop-shadow whitespace-nowrap">
        <span class="hero-name-line inline-block font-[var(--font-display)] font-black whitespace-nowrap">JUAN HOYOS</span>
      </h1>

      <div class="hero-pill hero-anim opacity-0 translate-y-6 inline-flex items-center space-x-2 px-3.5 py-1.5 mb-8 rounded-full backdrop-blur-md text-xs font-mono tracking-widest uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-blanco animate-pulse"></span>
        <span class="font-[var(--font-mono)]">{badge}</span>
      </div>

  <h3 class="hero-kicker">
    <span class="hero-kicker-text font-[var(--font-mono)]">{subtitle}</span>
    <span class="hero-caret" aria-hidden="true"></span>
  </h3>

  <p class="mt-8 text-gris-oscuro max-w-lg text-lg hero-text font-[var(--font-body)]">
    {description}
  </p>

      <div class="mt-12 flex gap-4 justify-center flex-wrap hero-buttons">
        <a
          href="https://www.linkedin.com/in/juan-esteban-hoyos-0b60912b4/"
          target="_blank"
          rel="noopener"
          class="hero-btn hero-cta-primary flex items-center gap-2 px-8 py-4 border-2 shadow-[4px_4px_0_black] hover:shadow-[6px_6px_0_black] hover:translate-x-0.5 hover:translate-y-0.5 transition-all duration-200 cursor-pointer font-[var(--font-body)]"
        >
          <Icon name="mdi:linkedin" class="w-5 h-5" />
          {btn_linkedin}
        </a>

        <a
          href={cv_path}
          download="CV_JuanHoyos.pdf"
          class="hero-btn hero-cta-secondary px-8 py-4 border-2 shadow-[4px_4px_0_black] hover:shadow-[6px_6px_0_black] hover:translate-x-0.5 hover:translate-y-0.5 transition-all duration-200 cursor-pointer font-[var(--font-body)]"
        >
          <span class="inline-flex items-center gap-2">
            <Icon name="mdi:download" class="w-5 h-5 hero-btn-icon" />
            {btn_cv}
          </span>
        </a>
      </div>
    </div>
  </div>

  <a
    href="#tecnologias"
  class="hero-scroll absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center gap-2 text-gris-claro hover:text-blanco transition-colors font-[var(--font-mono)]"
  aria-label={scroll_label}
>
    <span class="hero-scroll-text">{scroll_label}</span>
    <Icon name="mdi:chevron-down" class="hero-scroll-icon w-6 h-6" />
  </a>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initHeroBlocks } from '../util/heroBlocks';

  gsap.registerPlugin(ScrollTrigger);

  let heroInited = false;

  function initHero() {
    const banner = document.getElementById('inicio') as HTMLElement;
    const canvas = document.getElementById('starsCanvas') as HTMLCanvasElement;

    if (!banner || !canvas) return;
    if (heroInited) return;
    heroInited = true;

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    // Reserva de espacio del título
    const stars = initHeroBlocks(canvas, banner, (box) => {
      const vh = banner.clientHeight || window.innerHeight;
      const pad = Math.min(220, vh * 0.32);
      banner.style.setProperty('--hero-title-h', `${Math.round(pad)}px`);
    });

    const cleanups: Array<() => void> = [];
    const mm = gsap.matchMedia();

    // ── ANIMACIONES DE ENTRADA ───────────────────────────────
    const introSelectors = [
      '.hero-name',
      '.hero-anim',
      '.hero-kicker',
      '.hero-text',
      '.hero-buttons a',
      '.hero-scroll',
    ];

    if (reduceMotion) {
      gsap.set(introSelectors, { opacity: 1, y: 0, clearProps: 'all' });
      gsap.set('.hero-name-line', {
        opacity: 1,
        filter: 'none',
        letterSpacing: '-0.05em',
        scale: 1,
      });
    } else {
      const narrow = window.innerWidth < 640;
      gsap.set('.hero-name-line', {
        opacity: 0,
        filter: `blur(${narrow ? 10 : 14}px)`,
        letterSpacing: narrow ? '0.06em' : '0.22em',
        scale: 1.04,
        transformOrigin: '50% 50%',
      });
      gsap.set('.hero-anim', { opacity: 0, y: 16 });
      gsap.set('.hero-kicker', { opacity: 0, y: 12 });
      gsap.set('.hero-text', { opacity: 0, y: 16 });
      gsap.set('.hero-buttons a', { opacity: 0, y: 20 });
      gsap.set('.hero-scroll', { opacity: 0 });

      // La intro espera a que el loader libere la página (loader:done).
      let introPlayed = false;
      const playIntro = () => {
        if (introPlayed) return;
        introPlayed = true;
        if (typeof (stars as any).playIntro === 'function') {
          (stars as any).playIntro();
        }
        const tl = gsap.timeline({ delay: 0.15 });
        tl.to('.hero-name-line', {
          opacity: 1,
          filter: 'blur(0px)',
          letterSpacing: '-0.05em',
          scale: 1,
          duration: 1.45,
          ease: 'expo.out',
        })
          .to(
            '.hero-anim',
            { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' },
            '-=0.6',
          )
          .to(
            '.hero-kicker',
            { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' },
            '-=0.4',
          )
          .to(
            '.hero-text',
            { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' },
            '+=0.2',
          )
          .to(
            '.hero-buttons a',
            {
              opacity: 1,
              y: 0,
              stagger: 0.12,
              duration: 0.5,
              ease: 'back.out(1.5)',
            },
            '-=0.3',
          )
          .to(
            '.hero-scroll',
            { opacity: 1, duration: 0.6, ease: 'power2.out' },
            '-=0.2',
          );
      };

      const loader = document.getElementById('loader');
      if (!loader || loader.style.display === 'none') {
        playIntro();
      } else {
        window.addEventListener('loader:done', playIntro, { once: true });
      }
    }

    // ── Parallax sutil del DOM siguiendo el mouse ────────────
    if (!reduceMotion) {
      const onMove = (e: MouseEvent) => {
        const rect = banner.getBoundingClientRect();
        const nx = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        const ny = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        gsap.to('.hero-parallax', {
          x: nx * -12,
          y: ny * -10,
          duration: 0.8,
          ease: 'power2.out',
          overwrite: 'auto',
        });
      };
      banner.addEventListener('mousemove', onMove);
      cleanups.push(() => banner.removeEventListener('mousemove', onMove));
    }

    // ── Salida del hero ligada al scroll ─────────────────────
    mm.add(
      '(min-width: 1024px) and (prefers-reduced-motion: no-preference)',
      () => {
        const exit = gsap.timeline({
          scrollTrigger: {
            trigger: banner,
            start: 'top top',
            end: () => '+=' + Math.round(window.innerHeight * 0.6),
            pin: true,
            scrub: 0.8,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });

        exit
          .to(
            '.hero-content',
            { yPercent: -7, scale: 0.93, opacity: 0.1, ease: 'none' },
            0,
          )
          .to(canvas, { scale: 1.12, opacity: 0.08, ease: 'none' }, 0)
          .to('.hero-vignette', { opacity: 0.72, ease: 'none' }, 0)
          .to('.hero-scroll', { opacity: 0, ease: 'none' }, 0);

        return () => {
          exit.scrollTrigger?.kill();
          exit.kill();
        };
      },
    );

    mm.add(
      '(max-width: 1023px) and (prefers-reduced-motion: no-preference)',
      () => {
        const exit = gsap.timeline({
          scrollTrigger: {
            trigger: banner,
            start: 'top top',
            end: 'bottom top',
            scrub: 0.6,
          },
        });

        exit
          .to('.hero-content', { opacity: 0, y: -40, ease: 'none' }, 0)
          .to(canvas, { opacity: 0.15, ease: 'none' }, 0)
          .to('.hero-scroll', { opacity: 0, ease: 'none' }, 0);

        return () => {
          exit.scrollTrigger?.kill();
          exit.kill();
        };
      },
    );

    // ── Observer de tema — solo reacciona si 'light' cambió ──
    const themeObserver = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        const oldClasses = mutation.oldValue ?? '';
        const newClasses = document.documentElement.className;
        const wasLight = oldClasses.includes('light');
        const isNowLight = newClasses.includes('light');
        if (wasLight !== isNowLight) stars.updateTheme(isNowLight);
      }
    });
    themeObserver.observe(document.documentElement, {
      attributeFilter: ['class'],
      attributeOldValue: true,
    });
    stars.updateTheme(document.documentElement.classList.contains('light'));
    cleanups.push(() => themeObserver.disconnect());

    // ── Efecto magnético en botones ──────────────────────────
    const buttons = document.querySelectorAll<HTMLElement>('.hero-buttons a');

    buttons.forEach((btn) => {
      if (reduceMotion) return;

      const onMove = (e: MouseEvent) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        gsap.to(btn, {
          x: x * 0.3,
          y: y * 0.3,
          duration: 0.4,
          ease: 'power2.out',
        });
      };
      const onLeave = () =>
        gsap.to(btn, {
          x: 0,
          y: 0,
          duration: 0.6,
          ease: 'elastic.out(1, 0.4)',
        });
      const onDown = () => gsap.to(btn, { scale: 0.94, duration: 0.1 });
      const onUp = () =>
        gsap.to(btn, { scale: 1, duration: 0.3, ease: 'back.out(2)' });

      btn.addEventListener('mousemove', onMove);
      btn.addEventListener('mouseleave', onLeave);
      btn.addEventListener('mousedown', onDown);
      btn.addEventListener('mouseup', onUp);

      cleanups.push(() => {
        btn.removeEventListener('mousemove', onMove);
        btn.removeEventListener('mouseleave', onLeave);
        btn.removeEventListener('mousedown', onDown);
        btn.removeEventListener('mouseup', onUp);
      });
    });

    // ── Limpieza en navegación de Astro ──────────────────────
    const onBeforeSwap = () => {
      mm.revert();
      cleanups.forEach((fn) => fn());
      stars.destroy();
      heroInited = false;
    };
    document.addEventListener('astro:before-swap', onBeforeSwap, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }

  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  #starsCanvas {
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .grid-bg {
    background-image:
      radial-gradient(
        circle at 50% 50%,
        color-mix(in srgb, var(--color-blanco) 6%, var(--color-neutro)) 0%,
        var(--color-neutro) 80%
      ),
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-blanco) 3%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-blanco) 3%, transparent) 1px,
        transparent 1px
      );
    background-size: 100% 100%, 80px 80px, 80px 80px;
  }

  .hero-vignette {
    background: radial-gradient(
      ellipse at center,
      transparent 30%,
      color-mix(in srgb, var(--color-neutro) 85%, transparent) 80%,
      var(--color-neutro) 100%
    );
  }

  .hero-pill {
    border: 1px solid color-mix(in srgb, var(--color-blanco) 20%, transparent);
    background: color-mix(in srgb, var(--color-blanco) 5%, transparent);
    color: var(--color-gris-claro);
  }

  .hero-cta-primary {
    background: var(--color-blanco);
    color: var(--color-neutro);
    border-color: var(--color-blanco);
  }

  .hero-cta-primary:hover {
    background: color-mix(in srgb, var(--color-blanco) 85%, var(--color-neutro));
  }

  .hero-cta-secondary {
    background: transparent;
    color: var(--color-blanco);
    border-color: var(--color-blanco);
  }

  .hero-cta-secondary:hover {
    background: color-mix(in srgb, var(--color-blanco) 10%, transparent);
  }

  .text-glow {
    text-shadow:
      0 0 40px rgba(0, 0, 0, 0.9),
      0 0 80px rgba(0, 0, 0, 0.95),
      0 4px 20px rgba(0, 0, 0, 1);
  }

  .title-drop-shadow {
    filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 10px rgba(0, 0, 0, 0.8));
  }

  :global(html.light) .title-drop-shadow {
    filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.2))
      drop-shadow(0 0 10px rgba(0, 0, 0, 0.1));
  }

  .hero-name {
    font-family: var(--font-display);
  }

  .hero-name-line {
    display: inline-block;
    font-family: var(--font-display);
    white-space: nowrap;
  }

  /* ── Badge de disponibilidad ── */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-borde);
    border-radius: 9999px;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--color-gris-claro);
    background: color-mix(in srgb, var(--color-neutro) 70%, transparent);
    backdrop-filter: blur(6px);
  }

  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--color-secondary);
    animation: badge-pulse 2s ease-in-out infinite;
  }

  @keyframes badge-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-secondary) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 7px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  /* ── Kicker (subtítulo) + caret ── */
  .hero-kicker {
    margin-top: 1.1rem;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gris-claro);
    display: inline-flex;
    align-items: center;
  }

  .hero-caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 0.35rem;
    background: var(--color-secondary);
    vertical-align: -0.12em;
    animation: caret-blink 1.05s steps(1) infinite;
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  /* ── Cue de scroll ── */  .hero-scroll-text {
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .hero-scroll-icon {
    animation: scroll-bounce 1.8s ease-in-out infinite;
  }

  @keyframes scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  .hero-btn-icon {
    transition: transform 0.25s ease;
  }

  .hero-btn:hover .hero-btn-icon {
    transform: translateY(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge-dot,
    .hero-caret,
    .hero-scroll-icon {
      animation: none;
    }
  }
</style>
