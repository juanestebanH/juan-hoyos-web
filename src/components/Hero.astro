---
import { Icon } from 'astro-icon/components';

interface Props {
  subtitle: string;
  description: string;
  badge: string;
  btn_linkedin: string;
  btn_cv: string;
  cv_path: string;
  scroll_label: string;
}

const {
  subtitle,
  description,
  badge,
  btn_linkedin,
  btn_cv,
  cv_path,
  scroll_label,
} = Astro.props;
---

<section id="inicio" class="hero" data-hero-pending>
  <div class="hero-orbit" aria-hidden="true"></div>

  <div class="hero-shell">
    <div class="hero-top">
      <span class="hero-badge">
        <span class="hero-badge__dot"></span>
        {badge}
      </span>
      <span class="hero-coord">LAT 4.7110 · LON -74.0721</span>
    </div>

    <div class="hero-main">
      <p class="hero-kicker">
        <span class="hero-kicker__rule"></span>
        <span>{subtitle}</span>
      </p>

      <h1 class="hero-title" aria-label="Juan Hoyos">
        <span class="hero-line" aria-hidden="true">
          <span class="hero-word" data-hero-word>JUAN HOYOS</span>
        </span>
      </h1>

      <div class="hero-lower">
        <p class="hero-desc">{description}</p>

        <div class="hero-actions">
          <a
            href="https://www.linkedin.com/in/juan-esteban-hoyos-0b60912b4/"
            target="_blank"
            rel="noopener"
            class="hero-btn hero-btn--solid"
          >
            <Icon name="mdi:linkedin" class="hero-btn__icon" />
            <span>{btn_linkedin}</span>
          </a>

          <a
            href={cv_path}
            download="CV_JuanHoyos.pdf"
            class="hero-btn hero-btn--ghost"
          >
            <Icon name="mdi:download" class="hero-btn__icon hero-btn__icon--down" />
            <span>{btn_cv}</span>
          </a>
        </div>
      </div>
    </div>

  </div>

  <a href="#sobre-mi" class="hero-scroll" aria-label={scroll_label}>
    <span>{scroll_label}</span>
    <span class="hero-scroll__rail" aria-hidden="true">
      <span class="hero-scroll__dot"></span>
    </span>
  </a>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { splitChars } from '../util/text';

  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context | undefined;
  let exitTl: gsap.core.Timeline | undefined;
  let inited = false;

  function initHero() {
    const section = document.getElementById('inicio');
    if (!section || inited) return;
    inited = true;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const words = Array.from(
      section.querySelectorAll<HTMLElement>('[data-hero-word]'),
    );
    const chars = words.flatMap((word) => splitChars(word));

    const resetHero = () => {
      exitTl?.progress(0);
      section.removeAttribute('data-hero-pending');
      gsap.set(chars, {
        x: 0,
        yPercent: 0,
        z: 0,
        scaleX: 1,
        scaleY: 1,
        rotationX: 0,
        rotationY: 0,
        rotationZ: 0,
        opacity: 1,
      });
      gsap.set('.hero-main', { yPercent: 0, scale: 1 });
      gsap.set('.hero-orbit', { scale: 1, opacity: 1, rotation: 0 });
      gsap.set('.hero-kicker__rule', { scaleX: 1 });
      gsap.set(
        [
          '.hero-badge',
          '.hero-coord',
          '.hero-kicker',
          '.hero-desc',
          '.hero-actions',
          '.hero-scroll',
        ],
        { y: 0, opacity: 1 },
      );
    };

    ctx = gsap.context(() => {
      if (reduced) {
        gsap.set(
          '.hero-line, .hero-kicker, .hero-desc, .hero-actions, .hero-scroll, .hero-badge, .hero-coord',
          { opacity: 1, clearProps: 'transform' },
        );
        gsap.set('.hero-orbit, .hero-kicker__rule', { opacity: 1, scale: 1 });
        section.removeAttribute('data-hero-pending');
        return;
      }

      gsap.set(chars, {
        yPercent: -300,
        z: -320,
        scale: 0.76,
        rotationX: 68,
        rotationY: (index) => (index % 2 ? -16 : 16),
        rotationZ: (index) => ((index % 3) - 1) * 6,
        opacity: 0,
        transformOrigin: '50% 100%',
        force3D: true,
      });
      gsap.set(
        ['.hero-badge', '.hero-coord', '.hero-kicker', '.hero-desc', '.hero-actions a', '.hero-scroll'],
        { opacity: 0, y: 18 },
      );
      gsap.set('.hero-kicker__rule', { scaleX: 0, transformOrigin: 'left center' });
      gsap.set('.hero-orbit', { scale: 0.86, opacity: 0, rotation: -8 });
      section.removeAttribute('data-hero-pending');

      let played = false;
      let attachTitleExit: (() => void) | undefined;
      const play = () => {
        if (played) return;
        played = true;
        window.dispatchEvent(new CustomEvent('hero:intro'));

        const tl = gsap.timeline({ delay: 0.08 });
        tl.to(
          '.hero-orbit',
          { opacity: 1, scale: 1, rotation: 0, duration: 1.5, ease: 'power3.out' },
          0,
        )
          .to(
            '.hero-kicker',
            { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out' },
            0.08,
          )
          .to(
            '.hero-kicker__rule',
            { scaleX: 1, duration: 0.85, ease: 'expo.out' },
            0.14,
          )
          .to(
            chars,
            {
              yPercent: 0,
              z: 0,
              scale: 1,
              rotationX: 0,
              rotationY: 0,
              rotationZ: 0,
              duration: 1.55,
              stagger: { each: 0.045, from: 'center' },
              ease: 'power4.out',
            },
            0.2,
          )
          .to(
            chars,
            {
              opacity: 1,
              duration: 0.5,
              stagger: { each: 0.03, from: 'center' },
              ease: 'power1.out',
            },
            0.6,
          )
          .to(
            '.hero-badge',
            { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' },
            0.42,
          )
          .to(
            '.hero-coord',
            { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out' },
            0.5,
          )
          .to(
            '.hero-desc',
            { opacity: 1, y: 0, duration: 0.65, ease: 'power2.out' },
            1.45,
          )
          .to(
            '.hero-actions a',
            {
              opacity: 1,
              y: 0,
              duration: 0.6,
              stagger: 0.08,
              ease: 'power3.out',
            },
            1.6,
          )
          .to(
            '.hero-scroll',
            { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out' },
            1.75,
          );
        tl.eventCallback('onComplete', () => {
          section.classList.add('hero-intro-done');
          attachTitleExit?.();
          attachTitleExit = undefined;
        });
      };

      const loader = document.getElementById('loader');
      if (!loader || loader.style.display === 'none') play();
      else window.addEventListener('loader:done', play, { once: true });

      const mm = gsap.matchMedia();

      mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
        const exit = (exitTl = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: () => `+=${Math.round(window.innerHeight * 0.9)}`,
            pin: true,
            scrub: 1,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        }));

        exit
          .to('.hero-main', { yPercent: -2, scale: 0.92, ease: 'power1.inOut' }, 0)
          .to('.hero-badge', { y: -90, opacity: 0, ease: 'none' }, 0.05)
          .to('.hero-kicker', { y: -110, opacity: 0, ease: 'none' }, 0.08)
          .to('.hero-desc', { y: -150, opacity: 0, ease: 'none' }, 0.14)
          .to('.hero-actions', { y: -200, opacity: 0, ease: 'none' }, 0.18)
          .to(['.hero-scroll', '.hero-coord'], { opacity: 0, y: 20, ease: 'none' }, 0)
          .to('.hero-orbit', { scale: 1.35, opacity: 0, ease: 'none' }, 0);

        attachTitleExit = () => {
          if (!exitTl) return;
          exitTl.fromTo(
            '.hero-title .split-char',
            {
              x: 0,
              yPercent: 0,
              z: 0,
              scale: 1,
              rotationX: 0,
              rotationZ: 0,
              opacity: 1,
            },
            {
              x: (i) => (i % 2 ? 1 : -1) * (34 + (i % 5) * 32),
              yPercent: (i) => -16 - (i % 6) * 12,
              z: (i) => (i % 2 ? 70 : -70),
              scale: (i) => 0.82 + (i % 3) * 0.1,
              rotationX: (i) => ((i % 5) - 2) * 18,
              rotationZ: (i) => ((i % 3) - 1) * 22,
              opacity: 0,
              stagger: { each: 0.02, from: 'center' },
              duration: 0.9,
              ease: 'power1.inOut',
              immediateRender: false,
            },
            0,
          );
        };

        if (section.classList.contains('hero-intro-done')) {
          attachTitleExit();
          attachTitleExit = undefined;
        }

        return () => {
          attachTitleExit = undefined;
          exit.scrollTrigger?.kill();
          exit.kill();
          exitTl = undefined;
        };
      });

      mm.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => {
        const exit = (exitTl = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: 'bottom top',
            scrub: 0.5,
          },
        }));
        exit
          .to('.hero-main', { y: -50, opacity: 0.1, ease: 'none' }, 0)
          .to(['.hero-badge', '.hero-coord', '.hero-scroll'], { opacity: 0, ease: 'none' }, 0);

        return () => {
          exit.scrollTrigger?.kill();
          exit.kill();
          exitTl = undefined;
        };
      });
    }, section);

    if (!reduced && window.matchMedia('(pointer: fine)').matches) {
      const onMove = (event: PointerEvent) => {
        const rect = section.getBoundingClientRect();
        const x = (event.clientX / rect.width - 0.5) * 2;
        const y = (event.clientY / rect.height - 0.5) * 2;
        gsap.to('.hero-main', {
          x: x * -10,
          y: y * -8,
          duration: 0.9,
          ease: 'power2.out',
          overwrite: 'auto',
        });
      };
      section.addEventListener('pointermove', onMove);
      ctx.add(() => {
        section.removeEventListener('pointermove', onMove);
      });
    }

    const buttons = section.querySelectorAll<HTMLElement>('.hero-btn');
    if (!reduced && window.matchMedia('(pointer: fine)').matches) {
      buttons.forEach((button) => {
        const x = gsap.quickTo(button, 'x', { duration: 0.4, ease: 'power3.out' });
        const y = gsap.quickTo(button, 'y', { duration: 0.4, ease: 'power3.out' });
        button.addEventListener('pointermove', (event) => {
          const rect = button.getBoundingClientRect();
          x((event.clientX - rect.left - rect.width / 2) * 0.18);
          y((event.clientY - rect.top - rect.height / 2) * 0.24);
        });
        button.addEventListener('pointerleave', () => {
          x(0);
          y(0);
        });
      });
    }

    if (!reduced) {
      const resetAtTop = () => {
        if (window.scrollY > 2) return;
        if (!section.classList.contains('hero-intro-done')) return;
        resetHero();
      };
      window.addEventListener('scroll', resetAtTop, { passive: true });
      ctx.add(() => window.removeEventListener('scroll', resetAtTop));
    }
  }

  document.addEventListener('astro:page-load', initHero);
  if (document.readyState !== 'loading') initHero();
  else document.addEventListener('DOMContentLoaded', initHero);

  window.addEventListener(
    'astro:before-swap',
    () => {
      ctx?.revert();
      ctx = undefined;
      exitTl = undefined;
      inited = false;
    },
    { once: true },
  );
</script>

<style>
  :global(html.js) .hero[data-hero-pending] .hero-shell,
  :global(html.js) .hero[data-hero-pending] .hero-scroll,
  :global(html.js) .hero[data-hero-pending] .hero-orbit {
    visibility: hidden;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    padding: calc(var(--hud-height) + 2.5rem) clamp(1.25rem, 5vw, 4.5rem) 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-orbit {
    position: absolute;
    z-index: -1;
    top: 48%;
    left: 50%;
    width: min(92vw, 68rem);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-blanco) 6%, transparent);
    background:
      radial-gradient(
        circle at 50% 50%,
        color-mix(in srgb, var(--chapter-accent) 8%, transparent),
        transparent 58%
      );
    mask-image: radial-gradient(circle, #000 30%, transparent 72%);
    -webkit-mask-image: radial-gradient(circle, #000 30%, transparent 72%);
    pointer-events: none;
  }

  .hero-orbit::before,
  .hero-orbit::after {
    content: '';
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--color-blanco) 7%, transparent);
  }

  .hero-orbit::after {
    inset: 28%;
    border-style: solid;
    border-color: color-mix(in srgb, var(--chapter-accent) 12%, transparent);
  }

  .hero-shell {
    position: relative;
    z-index: 2;
    width: min(100%, 90rem);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    gap: 1.5rem;
    text-align: center;
  }

  .hero-top {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-blanco) 12%, transparent);
    background: color-mix(in srgb, var(--color-neutro) 55%, transparent);
    backdrop-filter: blur(10px);
    color: var(--color-gris-claro);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
  }

  .hero-badge__dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--chapter-accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--chapter-accent) 60%, transparent);
    animation: hero-pulse 2.4s ease-out infinite;
  }

  @keyframes hero-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--chapter-accent) 55%, transparent); }
    70% { box-shadow: 0 0 0 8px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hero-coord {
    position: absolute;
    right: 0;
    color: var(--color-gris-oscuro);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
  }

  .hero-main {
    width: 100%;
    max-width: 76rem;
    margin: auto;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    will-change: transform, opacity, filter;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: clamp(0.62rem, 1vw, 0.76rem);
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-gris-claro);
  }

  .hero-kicker__rule {
    display: inline-block;
    width: clamp(1.5rem, 4vw, 3.5rem);
    height: 1px;
    background: var(--chapter-accent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--chapter-accent) 60%, transparent);
  }

  .hero-main {
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.3rem, 10.6vw, 10.8rem);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -0.055em;
    text-transform: uppercase;
    white-space: nowrap;
    transform-style: preserve-3d;
  }

  .hero-line {
    display: block;
    overflow: visible;
    padding-right: 0.08em;
  }

  .hero-word {
    display: inline-block;
    white-space: nowrap;
    transform-style: preserve-3d;
  }

  .hero-word :global(.split-char) {
    display: inline-block;
    transform-style: preserve-3d;
    will-change: transform, opacity;
  }

  .hero-lower {
    margin-top: clamp(1.5rem, 4vh, 2.6rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.35rem;
    width: 100%;
  }

  .hero-desc {
    margin: 0;
    max-width: 38rem;
    font-size: clamp(0.95rem, 1.35vw, 1.15rem);
    line-height: 1.55;
    color: var(--color-gris-claro);
    text-align: center;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.3rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .hero-btn__icon {
    width: 1rem;
    height: 1rem;
  }

  .hero-btn--solid {
    background: var(--color-blanco);
    color: var(--color-neutro);
    border-color: var(--color-blanco);
  }

  .hero-btn--solid:hover {
    box-shadow: 0 0 34px -10px color-mix(in srgb, var(--chapter-accent) 70%, transparent);
  }

  .hero-btn--ghost {
    color: var(--color-blanco);
    border-color: color-mix(in srgb, var(--color-blanco) 24%, transparent);
    background: color-mix(in srgb, var(--color-neutro) 35%, transparent);
  }

  .hero-btn--ghost:hover {
    border-color: var(--color-blanco);
    background: color-mix(in srgb, var(--color-blanco) 7%, transparent);
  }

  .hero-btn:hover .hero-btn__icon--down {
    transform: translateY(3px);
  }

  .hero-btn__icon--down {
    transition: transform 0.25s ease;
  }

  .hero-scroll {
    position: relative;
    z-index: 3;
    width: min(100%, 90rem);
    margin: 1.5rem auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    color: var(--color-gris-oscuro);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .hero-scroll:hover {
    color: var(--color-blanco);
  }

  .hero-scroll__rail {
    position: relative;
    width: 4rem;
    height: 1px;
    background: color-mix(in srgb, var(--color-blanco) 14%, transparent);
    overflow: hidden;
  }

  .hero-scroll__dot {
    position: absolute;
    top: -1px;
    left: 0;
    width: 0.8rem;
    height: 3px;
    background: var(--chapter-accent);
    animation: hero-scroll-run 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes hero-scroll-run {
    0% { transform: translateX(-100%); }
    55% { transform: translateX(420%); }
    100% { transform: translateX(420%); }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: calc(var(--hud-height) + 1.5rem);
    }

    .hero-title {
      font-size: clamp(6rem, 10.4vw, 11rem);
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: clamp(3.1rem, 12vw, 5rem);
      line-height: 0.86;
    }

    .hero-actions {
      width: 100%;
    }

    .hero-btn {
      flex: 1;
      justify-content: center;
    }

    .hero-coord {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge__dot,
    .hero-scroll__dot {
      animation: none;
    }
  }
</style>
