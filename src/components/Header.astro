---
import { Icon } from 'astro-icon/components';
import { chapters } from '../data/chapters';
import AudioPlayer from './AudioPlayer.astro';

const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const switchPath = lang === 'es' ? '/en' : '/';
const copy = chapters.map((chapter) => ({
  ...chapter,
  text: chapter[lang],
}));
---

<header id="hud" class="hud">
  <div class="hud__inner">
    <a href="#inicio" class="hud__brand" aria-label="Juan Hoyos">
      <span class="hud__monogram">JH<span class="hud__monogram-dot">.</span></span>
      <span class="hud__status">
        <span class="hud__act">ACT <span id="hud-act">01</span></span>
        <span class="hud__tag" id="hud-tag">CORE</span>
      </span>
    </a>

    <nav class="hud__nav" aria-label={lang === 'es' ? 'Secciones' : 'Sections'}>
      {
        copy.map((chapter) => (
          <a
            class="hud__link"
            href={`#${chapter.id}`}
            data-hud-id={chapter.id}
            aria-label={`${chapter.index} ${chapter.text.label}`}
          >
            <span class="hud__num">{chapter.index}</span>
            <span class="hud__link-label">{chapter.text.short}</span>
          </a>
        ))
      }
    </nav>

    <div class="hud__tools">
      <button
        id="sfx-toggle"
        class="hud__tool hud__sfx"
        type="button"
        aria-pressed="false"
        aria-label={lang === 'es' ? 'Activar efectos de sonido' : 'Toggle sound effects'}
      >
        <Icon name="mdi:volume-off" class="hud__icon" data-sfx-icon />
        <span data-sfx-label>SFX</span>
      </button>

      <button
        id="pulse-btn"
        class="hud__tool hud__tool--pulse"
        type="button"
        aria-label={lang === 'es' ? 'Pulsar el mundo' : 'Pulse the world'}
      >
        <Icon name="mdi:lightning-bolt" class="hud__icon" />
        <span>PULSE</span>
      </button>

      <a id="idioma" class="hud__tool hud__lang" href={switchPath} aria-label="Language">
        {lang === 'es' ? 'EN' : 'ES'}
      </a>

      <button
        id="theme-toggle"
        class="hud__tool"
        type="button"
        aria-label={lang === 'es' ? 'Cambiar tema' : 'Toggle theme'}
      >
        <span id="theme-icon" aria-hidden="true">☀</span>
      </button>

      <button
        id="music-toggle"
        class="hud__tool music-btn"
        type="button"
        aria-label={lang === 'es' ? 'Música' : 'Music'}
      >
        <span id="music-icon">♪</span>
      </button>
    </div>

    <button
      id="menuBtn"
      class="hud__menu"
      type="button"
      aria-expanded="false"
      aria-controls="mobileMenu"
      aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
    >
      <span></span><span></span>
    </button>
  </div>
</header>

<div id="mobileMenu" class="hud-menu" aria-hidden="true">
  <div class="hud-menu__inner">
    <p class="hud-menu__kicker">INDEX // 01—06</p>

    <nav class="hud-menu__nav" aria-label={lang === 'es' ? 'Capítulos' : 'Chapters'}>
      {
        copy.map((chapter) => (
          <a
            class="hud-menu__link"
            href={`#${chapter.id}`}
            data-menu-id={chapter.id}
          >
            <span class="hud-menu__num">{chapter.index}</span>
            <span class="hud-menu__label">{chapter.text.label}</span>
            <span class="hud-menu__tag">{chapter.text.tag}</span>
          </a>
        ))
      }
    </nav>

    <div class="hud-menu__tools">
      <button
        id="sfx-toggle-mobile"
        class="hud-menu__tool"
        type="button"
        aria-pressed="false"
      >
        <span data-sfx-label>SFX OFF</span>
      </button>
      <button id="pulse-btn-mobile" class="hud-menu__tool" type="button">
        PULSE
      </button>
      <a class="hud-menu__tool" href={switchPath}>
        {lang === 'es' ? 'ENGLISH' : 'ESPAÑOL'}
      </a>
      <button
        id="theme-toggle-mobile"
        class="hud-menu__tool"
        type="button"
        aria-label={lang === 'es' ? 'Cambiar tema' : 'Toggle theme'}
      >
        <span id="theme-icon-mobile" aria-hidden="true">☀</span>
      </button>
      <button
        id="music-toggle-mobile"
        class="hud-menu__tool music-btn-mobile"
        type="button"
        aria-label={lang === 'es' ? 'Música' : 'Music'}
      >
        <span id="music-icon-mobile">♪</span>
      </button>
    </div>

    <p class="hud-menu__foot">
      JH-2026 // COLOMBIA <span>·</span> AVAILABLE FOR WORK
    </p>
  </div>
</div>

<AudioPlayer />

<script>
  import gsap from 'gsap';
  import { initSfx, isSfxEnabled, toggleSfx } from '../util/sfx';
  import { chapters } from '../data/chapters';

  const root = document.documentElement;

  initSfx();

  const menu = document.getElementById('mobileMenu');
  const menuBtn = document.getElementById('menuBtn');
  const menuLinks = Array.from(
    document.querySelectorAll<HTMLElement>('.hud-menu__link'),
  );
  const hudLinks = Array.from(
    document.querySelectorAll<HTMLElement>('[data-hud-id]'),
  );
  const actEl = document.getElementById('hud-act');
  const tagEl = document.getElementById('hud-tag');
  const lenis = () => (window as unknown as { __lenis?: any }).__lenis;

  let menuOpen = false;
  let activeId = 'inicio';
  let menuTl: gsap.core.Timeline | null = null;

  const monoAccent = () =>
    getComputedStyle(root).getPropertyValue('--chapter-accent').trim() ||
    (root.classList.contains('light') ? '#1a1a1a' : '#ffffff');

  const setAccent = () => {
    document.getElementById('hud')?.style.setProperty('--hud-accent', monoAccent());
  };

  const paintChapter = (id: string) => {
    activeId = id;
    hudLinks.forEach((link) => {
      const on = link.dataset.hudId === id;
      link.classList.toggle('is-active', on);
      if (on) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
    menuLinks.forEach((link) => {
      const on = link.dataset.menuId === id;
      link.classList.toggle('is-active', on);
    });

    const chapter = chapters.find((item) => item.id === id);
    if (chapter) {
      if (actEl) actEl.textContent = chapter.index;
      if (tagEl) tagEl.textContent = chapter[document.documentElement.lang === 'en' ? 'en' : 'es'].tag;
    }
    setAccent();
  };

  const onChapter = (event: Event) => {
    const detail = (event as CustomEvent<{ id: string }>).detail;
    if (!detail?.id) return;
    paintChapter(detail.id);
  };

  window.addEventListener('chapter:change', onChapter);
  window.addEventListener('chapter:accent', setAccent);
  window.addEventListener('theme:change', setAccent);

  const initial = root.dataset.chapter || 'inicio';
  paintChapter(initial);

  // ── Tema ──────────────────────────────────────────────
  const themeIcons = [
    document.getElementById('theme-icon'),
    document.getElementById('theme-icon-mobile'),
  ];

  const paintTheme = () => {
    const light = root.classList.contains('light');
    themeIcons.forEach((icon) => {
      if (icon) icon.textContent = light ? '☾' : '☀';
    });
  };

  const toggleTheme = () => {
    const light = root.classList.toggle('light');
    try {
      localStorage.setItem('theme', light ? 'light' : 'dark');
    } catch {
      /* ignora */
    }
    paintTheme();
    window.dispatchEvent(new CustomEvent('theme:change'));
  };

  paintTheme();
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document
    .getElementById('theme-toggle-mobile')
    ?.addEventListener('click', toggleTheme);

  // ── SFX ───────────────────────────────────────────────
  const sfxButtons = [
    document.getElementById('sfx-toggle'),
    document.getElementById('sfx-toggle-mobile'),
  ];

  const paintSfx = () => {
    const on = isSfxEnabled();
    sfxButtons.forEach((button) => {
      if (!button) return;
      button.setAttribute('aria-pressed', on ? 'true' : 'false');
      button.classList.toggle('is-on', on);
      button
        .querySelectorAll<HTMLElement>('[data-sfx-label]')
        .forEach((label) => {
          label.textContent = on ? 'SFX ON' : 'SFX OFF';
        });
    });
  };

  sfxButtons.forEach((button) =>
    button?.addEventListener('click', () => {
      toggleSfx();
      paintSfx();
    }),
  );
  paintSfx();

  // ── Pulso ─────────────────────────────────────────────
  const pulse = (event: Event) => {
    window.dispatchEvent(new CustomEvent('world:pulse'));
    const button = event.currentTarget as HTMLElement;
    gsap.fromTo(
      button,
      { scale: 1 },
      { scale: 0.9, duration: 0.08, yoyo: true, repeat: 1 },
    );
  };
  document.getElementById('pulse-btn')?.addEventListener('click', pulse);
  document.getElementById('pulse-btn-mobile')?.addEventListener('click', pulse);

  // ── Menú móvil ────────────────────────────────────────
  const openMenu = () => {
    if (!menu || menuOpen) return;
    menuOpen = true;
    menu.style.display = 'flex';
    menu.setAttribute('aria-hidden', 'false');
    menuBtn?.setAttribute('aria-expanded', 'true');
    menuBtn?.classList.add('is-open');
    lenis()?.stop();

    menuTl?.kill();
    menuTl = gsap.timeline();
    menuTl
      .fromTo(menu, { opacity: 0 }, { opacity: 1, duration: 0.25, ease: 'power2.out' })
      .fromTo(
        menuLinks,
        { y: 34, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.55,
          stagger: 0.055,
          ease: 'expo.out',
        },
        0.05,
      )
      .fromTo(
        '.hud-menu__tools, .hud-menu__foot, .hud-menu__kicker',
        { y: 18, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.45, stagger: 0.06, ease: 'power2.out' },
        0.2,
      );
  };

  const closeMenu = () => {
    if (!menu || !menuOpen) return;
    menuOpen = false;
    menu.setAttribute('aria-hidden', 'true');
    menuBtn?.setAttribute('aria-expanded', 'false');
    menuBtn?.classList.remove('is-open');
    lenis()?.start();

    menuTl?.kill();
    menuTl = gsap.timeline({
      onComplete: () => {
        if (menu) menu.style.display = 'none';
      },
    });
    menuTl.to(menu, { opacity: 0, duration: 0.22, ease: 'power2.in' });
  };

  menuBtn?.addEventListener('click', () => {
    if (menuOpen) closeMenu();
    else openMenu();
  });

  menuLinks.forEach((link) => link.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuOpen) closeMenu();
  });

  // ── Intro ─────────────────────────────────────────────
  const intro = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const tl = gsap.timeline({ delay: 0.1 });
    tl.fromTo(
      '.hud__inner',
      { y: -28, opacity: 0 },
      { y: 0, opacity: 1, duration: 1, ease: 'expo.out' },
    )
      .fromTo(
        '.hud__link',
        { y: -10, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.5, stagger: 0.05, ease: 'power2.out' },
        0.35,
      )
      .fromTo(
        '.hud__tools',
        { y: -8, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.45, ease: 'power2.out' },
        0.45,
      );
  };

  const loader = document.getElementById('loader');
  if (!loader || loader.style.display === 'none') {
    intro();
  } else {
    window.addEventListener('loader:done', intro, { once: true });
  }

  // Magnetic pills
  if (window.matchMedia('(pointer: fine)').matches) {
    document
      .querySelectorAll<HTMLElement>('.hud__tool')
      .forEach((element) => {
        const x = gsap.quickTo(element, 'x', {
          duration: 0.35,
          ease: 'power3.out',
        });
        const y = gsap.quickTo(element, 'y', {
          duration: 0.35,
          ease: 'power3.out',
        });
        element.addEventListener('pointermove', (event) => {
          const rect = element.getBoundingClientRect();
          x((event.clientX - rect.left - rect.width / 2) * 0.12);
          y((event.clientY - rect.top - rect.height / 2) * 0.18);
        });
        element.addEventListener('pointerleave', () => {
          x(0);
          y(0);
        });
      });
  }
</script>

<style>
  .hud {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 0.75rem clamp(0.75rem, 2vw, 1.5rem);
    pointer-events: none;
    --hud-accent: var(--chapter-accent);
  }

  .hud__inner {
    pointer-events: auto;
    width: min(100%, 90rem);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 0.7rem 0.55rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--color-blanco) 9%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-neutro) 72%, transparent);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    box-shadow: 0 12px 40px -28px rgba(0, 0, 0, 0.9);
  }

  .hud__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-blanco);
    text-decoration: none;
    flex: none;
  }

  .hud__monogram {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .hud__monogram-dot {
    color: var(--hud-accent);
    text-shadow: 0 0 14px color-mix(in srgb, var(--hud-accent) 70%, transparent);
  }

  .hud__status {
    display: none;
    padding-left: 0.65rem;
    border-left: 1px solid color-mix(in srgb, var(--color-blanco) 14%, transparent);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.45;
    color: var(--color-gris-oscuro);
  }

  .hud__act {
    display: block;
    color: var(--hud-accent);
  }

  .hud__tag {
    display: block;
  }

  .hud__nav {
    display: none;
    align-items: center;
    gap: 0.1rem;
    margin-left: auto;
  }

  .hud__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28rem;
    padding: 0.5rem 0.6rem;
    border-radius: 999px;
    color: var(--color-gris-oscuro);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      color 0.3s ease,
      background 0.3s ease;
  }

  .hud__num {
    font-size: 7px;
    opacity: 0.5;
    font-variant-numeric: tabular-nums;
  }

  .hud__link:hover {
    color: var(--color-blanco);
    background: color-mix(in srgb, var(--color-blanco) 5%, transparent);
  }

  .hud__link.is-active {
    color: var(--hud-accent);
    background: color-mix(in srgb, var(--hud-accent) 8%, transparent);
  }

  .hud__tools {
    display: none;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }

  .hud__link.is-active + .hud__tools {
    margin-left: 0;
  }

  .hud__tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    height: 1.9rem;
    min-width: 1.9rem;
    padding: 0 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-blanco) 11%, transparent);
    background: transparent;
    color: var(--color-gris-oscuro);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      color 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .hud__tool:hover {
    color: var(--color-blanco);
    border-color: color-mix(in srgb, var(--color-blanco) 30%, transparent);
  }

  .hud__tool.is-on {
    color: var(--hud-accent);
    border-color: color-mix(in srgb, var(--hud-accent) 42%, transparent);
  }

  .hud__tool--pulse {
    color: var(--hud-accent);
    border-color: color-mix(in srgb, var(--hud-accent) 30%, transparent);
  }

  .hud__icon {
    width: 0.9rem;
    height: 0.9rem;
  }

  .hud__menu {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: auto;
    padding: 0 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-blanco) 12%, transparent);
    background: transparent;
  }

  .hud__menu span {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--color-blanco);
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .hud__menu.is-open span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .hud__menu.is-open span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* ── Menú móvil ── */
  .hud-menu {
    position: fixed;
    inset: 0;
    z-index: 48;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 5.5rem 1.25rem 2rem;
    background:
      radial-gradient(
        70% 60% at 50% 30%,
        color-mix(in srgb, var(--hud-accent, #fff) 10%, transparent),
        transparent 70%
      ),
      color-mix(in srgb, var(--color-neutro) 97%, transparent);
    backdrop-filter: blur(26px);
    -webkit-backdrop-filter: blur(26px);
    opacity: 0;
  }

  .hud-menu__inner {
    width: min(100%, 34rem);
    max-height: 100%;
    overflow-y: auto;
  }

  .hud-menu__kicker {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-gris-oscuro);
  }

  .hud-menu__nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid color-mix(in srgb, var(--color-blanco) 12%, transparent);
  }

  .hud-menu__link {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.8rem 0.2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-blanco) 9%, transparent);
    color: var(--color-gris-claro);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .hud-menu__link:hover,
  .hud-menu__link.is-active {
    color: var(--hud-accent);
  }

  .hud-menu__num {
    width: 1.5rem;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-gris-oscuro);
  }

  .hud-menu__label {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 7vw, 2.3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .hud-menu__tag {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gris-oscuro);
  }

  .hud-menu__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.5rem;
  }

  .hud-menu__tool {
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-blanco) 13%, transparent);
    background: transparent;
    color: var(--color-gris-claro);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hud-menu__foot {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gris-oscuro);
  }

  .hud-menu__foot span {
    color: var(--hud-accent);
  }

  @media (min-width: 640px) {
    .hud__status {
      display: block;
    }
  }

  @media (min-width: 768px) {
    .hud__tools {
      display: flex;
    }

    .hud__menu {
      margin-left: 0;
    }
  }

  @media (min-width: 1280px) {
    .hud__nav {
      display: flex;
      margin-left: auto;
    }

    .hud__tools {
      margin-left: 0.35rem;
    }

    .hud__menu {
      display: none;
    }

    .hud-menu {
      display: none !important;
    }
  }

  @media (max-width: 767px) {
    .hud__inner {
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hud__menu span,
    .hud__link,
    .hud__tool,
    .hud-menu__link {
      transition: none;
    }
  }
</style>
